 - publish_time: \"一周内\"（获取最新数据）\n  - note_type: \"不限\"\n\n报告每个关键词的搜索结果数量\n\n## 步骤 2：合并去重\n合并所有搜索结果，按点赞数排序，去除重复笔记\n\n## 步骤 3：筛选爆款\n严格筛选：\n- 发布时间：{publish_time} 内\n- 点赞数：≥{min_likes}\n\n## 步骤 4：保存数据\n保存到当前目录的 data.json 文件\n\n格式（V8.1 - 需要 collectedCount 和 commentCount）：\n```json\n{{\n  \"feeds\": [{{\n    \"id\": \"笔记ID\",\n    \"title\": \"标题\",\n    \"nickname\": \"博主昵称\",\n    \"likedCount\": 点赞数,\n    \"collectedCount\": 收藏数,\n    \"commentCount\": 评论数,\n    \"publishTime\": \"发布时间\"\n  }}],\n  \"keywords\": {json.dumps(keywords, ensure_ascii=False)},\n  \"fetched_at\": \"{datetime.now().isoformat()}\",\n  \"mode\": \"trending\",\n  \"keywords_executed\": []\n}}\n```\n\n**重要**：不要包含 fans 字段\n\n## 步骤 5：返回摘要\n返回搜索结果统计和筛选后的笔记数量\n\"\"\"\n\n    return prompt\n\n\ndef run_agent():\n    \"\"\"运行智谱 AI Agent\"\"\"\n    print(\"=\" * 60)\n    print(\"智谱 AI Agent Runner - xhs-topic-analyzer\")\n    print(\"=\" * 60)\n\n    # 1. 检查环境变量\n    api_key = os.environ.get(\"ZHIPU_API_KEY\")\n    if not api_key:\n        print(\"[Error] 缺少 ZHIPU_API_KEY 环境变量\")\n        sys.exit(1)\n\n    print(\"[Step 1] 初始化智谱 AI 客户端...\")\n    client = ZhipuAI(api_key=api_key)\n\n    # 2. 加载配置\n    print(\"[Step 2] 加载配置文件...\")\n    config = load_config()\n    keywords = config.get(\"keywords\", [])\n    print(f\"  ✓ 已加载 {len(keywords)} 个搜索关键词\")\n\n    # 3. 构建任务提示词\n    print(\"[Step 3] 构建任务提示词...\")\n    task_prompt = build_task_prompt(config)\n\n    # 4. 调用智谱 AI API\n    print(\"[Step 4] 调用智谱 AI API...\")\n    print(\"  - Model: glm-4-plus\")\n    print(\"  - Max tokens: 8192\")\n    print(\"  - Tools: mcp__xiaohongshu__search_feeds\")\n\n    try:\n        # 智谱 AI API 调用\n        # 注意：智谱 AI 的 API 格式与 Anthropic 不同\n        response = client.chat.completions.create(\n            model=\"glm-4-plus\",\n            messages=[{\n                \"role\": \"user\",\n                \"content\": task_prompt\n            }],\n            max_tokens=8192,\n            temperature=0.7\n        )\n\n        print(f\"  ✓ API 调用成功\")\n        print(f\"  - Finish reason: {response.choices[0].finish_reason}\")\n        print(f\"  - Usage: {response.usage.total_tokens} tokens\")\n\n        # 提取响应内容\n        assistant_message = response.choices[0].message.content\n\n    except Exception as e:\n        print(f\"[Error] 智谱 AI API 调用失败: {e}\")\n        sys.exit(1)\n\n    # 5. 检查是否生成了 data.json\n    print(\"[Step 5] 检查数据文件...\")\n    data_file = \"data.json\"\n\n    if not os.path.exists(data_file):\n        print(f\"[Error] 未找到 {data_file}\")\n        print(\"[Info] Agent 响应内容:\")\n        print(assistant_message)\n        sys.exit(1)\n\n    # 6. 验证数据文件\n    try:\n        with open(data_file, 'r', encoding='utf-8') as f:\n            data = json.load(f)\n\n        feeds = data.get(\"feeds\", [])\n        print(f\"  ✓ 数据文件已生成\")\n        print(f\"  - 笔记数量: {len(feeds)}\")\n\n        if len(feeds) > 0:\n            print(f\"  - 示例笔记: {feeds[0].get('title', 'N/A')[:30]}...\")\n\n    except Exception as e:\n        print(f\"[Error] 数据文件格式错误: {e}\")\n        sys.exit(1)\n\n    print(\"=\" * 60)\n    print(\"✓ Agent 执行完成\")\n    print(\"=\" * 60)\n\n\nif __name__ == \"__main__\":\n    run_agent()\n","numLines":187,"startLine":1,"totalLines":187}},"sourceToolAssistantUUID":"f493e19f-ccee-4c90-bd3c-871c10eb8a8c"}
{"parentUuid":"7a63173b-b12e-4e4d-9b94-9cfadad0b1ed","isSidechain":true,"userType":"external","cwd":"/Users/henry","sessionId":"06c37e8c-5774-4712-881a-2f328c6d3405","version":"2.1.12","gitBranch":"","agentId":"afcb03c","slug":"gleaming-watching-tiger","type":"user","message":{"role":"user","content":[{"tool_use_id":"call_268be42f1301480d8d82e2fc","type":"tool_result","content":"     1→name: 小红书财经爆款日报\n     2→\n     3→on:\n     4→  # 定时触发：每天北京时间 09:00 (UTC 01:00)\n     5→  schedule:\n     6→    - cron: '0 1 * * *'\n     7→\n     8→  # 手动触发\n     9→  workflow_dispatch:\n    10→\n    11→env:\n    12→  ZHIPU_API_KEY: ${{ secrets.ZHIPU_API_KEY }}\n    13→  WECHAT_PUSH_TOKEN: ${{ secrets.WECHAT_PUSH_TOKEN }}\n    14→\n    15→jobs:\n    16→  generate-report:\n    17→    runs-on: ubuntu-latest\n    18→    timeout-minutes: 30\n    19→\n    20→    steps:\n    21→      - name: Checkout 代码\n    22→        uses: actions/checkout@v4\n    23→\n    24→      - name: 设置 Python 环境\n    25→        uses: actions/setup-python@v5\n    26→        with:\n    27→          python-version: '3.11'\n    28→          cache: 'pip'\n    29→\n    30→      - name: 安装依赖\n    31→        run: |\n    32→          pip install --upgrade pip\n    33→          pip install -r requirements.txt\n    34→\n    35→      - name: 准备小红书 Cookies\n    36→        run: |\n    37→          echo '${{ secrets.XHS_COOKIES }}' > /tmp/xhs_cookies.json\n    38→          echo \"✓ Cookies 文件已创建\"\n    39→\n    40→      - name: 启动 xiaohongshu-mcp Server\n    41→        run: |\n    42→          echo \"启动 MCP Server...\"\n    43→          nohup xiaohongshu-mcp serve --port 3000 --cookies /tmp/xhs_cookies.json > /tmp/mcp_server.log 2>&1 &\n    44→\n    45→          # 等待服务启动\n    46→          echo \"等待 MCP Server 启动...\"\n    47→          for i in {1..10}; do\n    48→            if curl -s http://localhost:3000/health > /dev/null 2>&1; then\n    49→              echo \"✓ MCP Server 已就绪\"\n    50→              break\n    51→            fi\n    52→            echo \"等待中... ($i/10)\"\n    53→            sleep 2\n    54→          done\n    55→\n    56→          # 检查是否成功启动\n    57→          if ! curl -s http://localhost:3000/health > /dev/null 2>&1; then\n    58→            echo \"✗ MCP Server 启动失败，查看日志：\"\n    59→            cat /tmp/mcp_server.log\n    60→            exit 1\n    61→          fi\n    62→\n    63→      - name: 运行智谱 AI Agent\n    64→        run: |\n    65→          python scripts/agent_runner.py\n    66→        env:\n    67→          ZHIPU_API_KEY: ${{ secrets.ZHIPU_API_KEY }}\n    68→\n    69→      - name: 数据校验\n    70→        run: |\n    71→          python scripts/validate_data.py data.json\n    72→\n    73→      - name: 生成报告并推送微信\n    74→        run: |\n    75→          python scripts/push_report.py --file data.json\n    76→        env:\n    77→          WECHAT_PUSH_TOKEN: ${{ secrets.WECHAT_PUSH_TOKEN }}\n    78→\n    79→      - name: 上传报告数据（可选）\n    80→        if: success()\n    81→        uses: actions/upload-artifact@v4\n    82→        with:\n    83→          name: daily-report-${{ github.run_number }}\n    84→          path: |\n    85→            data.json\n    86→          retention-days: 7\n    87→\n    88→      - name: 清理\n    89→        if: always()\n    90→        run: |\n    91→          # 停止 MCP Server\n    92→          pkill -f xiaohongshu-mcp || true\n    93→\n    94→          # 删除敏感文件\n    95→          rm -f /tmp/xhs_cookies.json\n    96→          rm -f data.json\n    97→\n    98→          echo \"✓ 清理完成\"\n    99→\n   100→      - name: 失败通知\n   101→        if: failure()\n   102→        run: |\n   103→          # 如果执行失败，发送通知到微信\n   104→          curl -X POST http://www.pushplus.plus/send \\\n   105→            -H \"Content-Type: application/json\" \\\n   106→            -d '{\n   107→              \"token\": \"${{ secrets.WECHAT_PUSH_TOKEN }}\",\n   108→              \"title\": \"⚠️ 小红书爆款日报执行失败\",\n   109→              \"content\": \"GitHub Actions 执行失败，请查看日志: https://github.com/${{ github.repository }}/actions/runs/${{ github.run_id }}\",\n   110→              \"template\": \"markdown\"\n   111→            }' || true\n   112→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"uuid":"e739675a-4f40-4cf2-93de-661d90b55058","timestamp":"2026-01-20T01:34:42.147Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/henry/.claude/skills/xhs-topic-analyzer/.github/workflows/xhs-daily-report.yml","content":"name: 小红书财经爆款日报\n\non:\n  # 定时触发：每天北京时间 09:00 (UTC 01:00)\n  schedule:\n    - cron: '0 1 * * *'\n\n  # 手动触发\n  workflow_dispatch:\n\nenv:\n  ZHIPU_API_KEY: ${{ secrets.ZHIPU_API_KEY }}\n  WECHAT_PUSH_TOKEN: ${{ secrets.WECHAT_PUSH_TOKEN }}\n\njobs:\n  generate-report:\n    runs-on: ubuntu-latest\n    timeout-minutes: 30\n\n    steps:\n      - name: Checkout 代码\n        uses: actions/checkout@v4\n\n      - name: 设置 Python 环境\n        uses: actions/setup-python@v5\n        with:\n          python-version: '3.11'\n          cache: 'pip'\n\n      - name: 安装依赖\n        run: |\n          pip install --upgrade pip\n          pip install -r requirements.txt\n\n      - name: 准备小红书 Cookies\n        run: |\n          echo '${{ secrets.XHS_COOKIES }}' > /tmp/xhs_cookies.json\n          echo \"✓ Cookies 文件已创建\"\n\n      - name: 启动 xiaohongshu-mcp Server\n        run: |\n          echo \"启动 MCP Server...\"\n          nohup xiaohongshu-mcp serve --port 3000 --cookies /tmp/xhs_cookies.json > /tmp/mcp_server.log 2>&1 &\n\n          # 等待服务启动\n          echo \"等待 MCP Server 启动...\"\n          for i in {1..10}; do\n            if curl -s http://localhost:3000/health > /dev/null 2>&1; then\n              echo \"✓ MCP Server 已就绪\"\n              break\n            fi\n            echo \"等待中... ($i/10)\"\n            sleep 2\n          done\n\n          # 检查是否成功启动\n          if ! curl -s http://localhost:3000/health > /dev/null 2>&1; then\n            echo \"✗ MCP Server 启动失败，查看日志：\"\n            cat /tmp/mcp_server.log\n            exit 1\n          fi\n\n      - name: 运行智谱 AI Agent\n        run: |\n          python scripts/agent_runner.py\n        env:\n          ZHIPU_API_KEY: ${{ secrets.ZHIPU_API_KEY }}\n\n      - name: 数据校验\n        run: |\n          python scripts/validate_data.py data.json\n\n      - name: 生成报告并推送微信\n        run: |\n          python scripts/push_report.py --file data.json\n        env:\n          WECHAT_PUSH_TOKEN: ${{ secrets.WECHAT_PUSH_TOKEN }}\n\n      - name: 上传报告数据（可选）\n        if: success()\n        uses: actions/upload-artifact@v4\n        with:\n          name: daily-report-${{ github.run_number }}\n          path: |\n            data.json\n          retention-days: 7\n\n      - name: 清理\n        if: always()\n        run: |\n          # 停止 MCP Server\n          pkill -f xiaohongshu-mcp || true\n\n          # 删除敏感文件\n          rm -f /tmp/xhs_cookies.json\n          rm -f data.json\n\n          echo \"✓ 清理完成\"\n\n      - name: 失败通知\n        if: failure()\n        run: |\n          # 如果执行失败，发送通知到微信\n          curl -X POST http://www.pushplus.plus/send \\\n            -H \"Content-Type: application/json\" \\\n            -d '{\n              \"token\": \"${{ secrets.WECHAT_PUSH_TOKEN }}\",\n              \"title\": \"⚠️ 小红书爆款日报执行失败\",\n              \"content\": \"GitHub Actions 执行失败，请查看日志: https://github.com/${{ github.repository }}/actions/runs/${{ github.run_id }}\",\n              \"template\": \"markdown\"\n            }' || true\n","numLines":112,"startLine":1,"totalLines":112}},"sourceToolAssistantUUID":"7a63173b-b12e-4e4d-9b94-9cfadad0b1ed"}
