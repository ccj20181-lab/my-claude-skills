2026-01-20T01:34:45.285Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/henry/.claude/skills/xhs-topic-analyzer/config.json","content":"{\n    \"keywords\": [\n        \"金融\",\n        \"金融知识\",\n        \"财经\",\n        \"财经热点\",\n        \"理财\",\n        \"理财知识\",\n        \"基金\",\n        \"股票\",\n        \"存钱\",\n        \"投资理财\"\n    ],\n    \"filters\": {\n        \"publish_time\": \"3d\",\n        \"min_likes\": 2000\n    },\n    \"exclude_keywords\": [\n        \"自媒体\",\n        \"涨粉\",\n        \"运营\",\n        \"剪辑\",\n        \"文案\",\n        \"ip\",\n        \"博主\",\n        \"美妆\",\n        \"穿搭\",\n        \"情感\",\n        \"恋爱\",\n        \"读书\",\n        \"书单\",\n        \"阅读\",\n        \"认知\",\n        \"思维\",\n        \"自律\",\n        \"成长\",\n        \"励志\",\n        \"人生\",\n        \"感悟\",\n        \"减肥\",\n        \"健身\",\n        \"食谱\",\n        \"好物\",\n        \"vlog\",\n        \"OOTD\"\n    ],\n    \"pushplus_token\": \"a6443f3a5d0f4b11a42c281f831b5c15\"\n}\n","numLines":49,"startLine":1,"totalLines":49}},"sourceToolAssistantUUID":"00c526a4-fd14-4224-a918-d94e9bf49ae6"}
{"parentUuid":"bf7b31bd-3c79-4dc2-b8ee-383b707c8232","isSidechain":true,"userType":"external","cwd":"/Users/henry","sessionId":"06c37e8c-5774-4712-881a-2f328c6d3405","version":"2.1.12","gitBranch":"","agentId":"afcb03c","slug":"gleaming-watching-tiger","type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01edc24dc71542839b22c6d4","type":"tool_result","content":"     1→# -*- coding: utf-8 -*-\n     2→\"\"\"\n     3→推送小红书热点选题报告到微信 (V8.1 - 深度选题分析)\n     4→专注财经赛道：3天内 + 2000赞以上\n     5→\"\"\"\n     6→import requests\n     7→import argparse\n     8→import os\n     9→import sys\n    10→import json\n    11→from datetime import datetime\n    12→from collections import Counter\n    13→\n    14→\n    15→def load_config():\n    16→    \"\"\"加载配置文件\"\"\"\n    17→    config_path = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), 'config.json')\n    18→    if os.path.exists(config_path):\n    19→        try:\n    20→            with open(config_path, 'r', encoding='utf-8') as f:\n    21→                return json.load(f)\n    22→        except Exception as e:\n    23→            print(f\"[Warning] Config load failed: {e}\")\n    24→    return {}\n    25→\n    26→\n    27→def format_number(num):\n    28→    \"\"\"格式化数字\"\"\"\n    29→    try:\n    30→        num = int(num)\n    31→    except (ValueError, TypeError):\n    32→        num = 0\n    33→    if num >= 10000:\n    34→        return f\"{num/10000:.1f}万\"\n    35→    return str(num)\n    36→\n    37→\n    38→def load_data(data_file):\n    39→    \"\"\"加载数据\"\"\"\n    40→    with open(data_file, 'r', encoding='utf-8') as f:\n    41→        raw_data = json.load(f)\n    42→\n    43→    if isinstance(raw_data, dict) and \"feeds\" in raw_data:\n    44→        raw_data = raw_data[\"feeds\"]\n    45→\n    46→    flat_data = []\n    47→    for item in raw_data:\n    48→        if \"noteCard\" in item:\n    49→            card = item[\"noteCard\"]\n    50→            flat_item = {\n    51→                \"id\": item.get('id', ''),\n    52→                \"title\": card.get(\"displayTitle\", \"\") or \"无标题\",\n    53→                \"author\": card.get(\"user\", {}).get(\"nickname\", \"\"),\n    54→                \"likes\": card.get(\"interactInfo\", {}).get(\"likedCount\", 0),\n    55→                \"collects\": card.get(\"interactInfo\", {}).get(\"collectedCount\", 0),\n    56→                \"comments\": card.get(\"interactInfo\", {}).get(\"commentCount\", 0),\n    57→                \"url\": f\"https://www.xiaohongshu.com/explore/{item.get('id', '')}\"\n    58→            }\n    59→            flat_data.append(flat_item)\n    60→        else:\n    61→            # 支持新格式（nickname）和旧格式（author）\n    62→            flat_item = {\n    63→                \"id\": item.get('id', ''),\n    64→                \"title\": item.get('title', '无标题'),\n    65→                \"author\": item.get('nickname') or item.get('author', ''),\n    66→                \"likes\": item.get('likedCount', 0) or item.get('likes', 0),\n    67→                \"collects\": item.get('collectedCount', 0),\n    68→                \"comments\": item.get('commentCount', 0),\n    69→                \"url\": f\"https://www.xiaohongshu.com/explore/{item.get('id', '')}\"\n    70→            }\n    71→            flat_data.append(flat_item)\n    72→\n    73→    return flat_data\n    74→\n    75→\n    76→def analyze_topics(notes):\n    77→    \"\"\"深度分析选题类型和特征\"\"\"\n    78→\n    79→    # 关键词分类\n    80→    topic_keywords = {\n    81→        \"理财技巧\": [\"存钱\", \"攒钱\", \"理财\", \"财富\", \"资产\", \"收益\"],\n    82→        \"金融知识\": [\"金融\", \"银行\", \"利率\", \"通货\", \"货币\", \"经济\"],\n    83→        \"投资教程\": [\"股票\", \"基金\", \"投资\", \"买入\", \"卖出\", \"持仓\", \"A股\"],\n    84→        \"财经热点\": [\"政策\", \"美国\", \"中国\", \"市场\", \"新闻\", \"分析\", \"观点\"],\n    85→        \"理财心态\": [\"心安\", \"底气\", \"焦虑\", \"稳定\", \"长期\", \"规划\"],\n    86→        \"生活理财\": [\"女生\", \"打工人\", \"年轻人\", \"新手\", \"小白\", \"入门\"],\n    87→    }\n    88→\n    89→    topic_counts = {topic: 0 for topic in topic_keywords.keys()}\n    90→    topic_examples = {topic: [] for topic in topic_keywords.keys()}\n    91→\n    92→    for note in notes:\n    93→        title = note['title'].lower()\n    94→        matched = False\n    95→        for topic, keywords in topic_keywords.items():\n    96→            if any(kw in title for kw in keywords):\n    97→                topic_counts[topic] += 1\n    98→                if len(topic_examples[topic]) < 3:  # 每个类型最多保存3个例子\n    99→                    topic_examples[topic].append({\n   100→                        'title': note['title'],\n   101→                        'likes': note['likes']\n   102→                    })\n   103→                matched = True\n   104→                break\n   105→\n   106→    # 标题长度分析\n   107→    title_lengths = [len(note['title']) for note in notes]\n   108→    avg_length = sum(title_lengths) / len(title_lengths) if title_lengths else 0\n   109→\n   110→    # 互动率分析\n   111→    engagement_rates = []\n   112→    for note in notes:\n   113→        if note['likes'] > 0:\n   114→            engagement = (note['comments'] + note['collects']) / note['likes']\n   115→            engagement_rates.append(engagement)\n   116→\n   117→    avg_engagement = sum(engagement_rates) / len(engagement_rates) if engagement_rates else 0\n   118→\n   119→    return {\n   120→        'topic_distribution': topic_counts,\n   121→        'topic_examples': topic_examples,\n   122→        'avg_title_length': avg_length,\n   123→        'avg_engagement_rate': avg_engagement\n   124→    }\n   125→\n   126→\n   127→def generate_content(data_file):\n   128→    \"\"\"生成推送内容（V8.1 - 深度分析版）\"\"\"\n   129→    raw_data = load_data(data_file)\n   130→\n   131→    # 财经赛道爆款标准：2000赞以上\n   132→    min_likes = 2000\n   133→    hits = []\n   134→\n   135→    for note in raw_data:\n   136→        likes = int(note.get('likes', 0))\n   137→        if likes >= min_likes:\n   138→            hits.append(note)\n   139→\n   140→    # 按点赞排序\n   141→    hits = sorted(hits, key=lambda x: x['likes'], reverse=True)\n   142→\n   143→    # 深度分析\n   144→    analysis = analyze_topics(hits)\n   145→\n   146→    today = datetime.now().strftime(\"%Y-%m-%d\")\n   147→\n   148→    # ========== 开始构建报告 ==========\n   149→    content = f\"\"\"## 💰 小红书财经爆款选题日报\n   150→\n   151→**📅 {today}** | 筛选：点赞≥2000 | 时间：3天内 | 共 {len(hits)} 条\n   152→\n   153→─────────────────────────────────────────\n   154→\n   155→### 📊 TOP 10 热点选题\n   156→\n   157→\"\"\"\n   158→\n   159→    # TOP 10 笔记\n   160→    top10 = hits[:10]\n   161→    for i, note in enumerate(top10, 1):\n   162→        title = note['title']\n   163→        likes = format_number(note['likes'])\n   164→        collects = format_number(note['collects'])\n   165→        comments = format_number(note['comments'])\n   166→        author = note['author']\n   167→        url = note['url']\n   168→\n   169→        content += f\"**【第{i}名】** {title}\\n\"\n   170→        content += f\"❤️ {likes}  |  ⭐ {collects}  |  💬 {comments}  |  @{author}\\n\"\n   171→        content += f\"🔗 {url}\\n\\n\"\n   172→\n   173→    # ========== 选题分布分析 ==========\n   174→    content += \"\"\"\n   175→─────────────────────────────────────────\n   176→\n   177→### 📈 选题分布分析\n   178→\n   179→\"\"\"\n   180→\n   181→    sorted_topics = sorted(analysis['topic_distribution'].items(),\n   182→                          key=lambda x: x[1], reverse=True)\n   183→\n   184→    for topic, count in sorted_topics:\n   185→        if count > 0:\n   186→            percentage = (count / len(hits)) * 100\n   187→            content += f\"**{topic}**: {count}条 ({percentage:.1f}%)\\n\"\n   188→            # 展示该类型的代表性笔记\n   189→            if analysis['topic_examples'][topic]:\n   190→                example = analysis['topic_examples'][topic][0]\n   191→                content += f\"  └ 代表：「{example['title']}」({format_number(example['likes'])}赞)\\n\"\n   192→            content += \"\\n\"\n   193→\n   194→    # ========== 深度选题洞察 ==========\n   195→    content += f\"\"\"\n   196→─────────────────────────────────────────\n   197→\n   198→### 🔍 深度选题洞察\n   199→\n   200→#### 📝 标题特征分析\n   201→- **平均标题长度**: {analysis['avg_title_length']:.0f} 字\n   202→- **最佳长度区间**: 15-25字（易读性与信息量平衡）\n   203→- **标题公式**: 数字+动作词+目标人群+价值点\n   204→\n   205→#### 💬 互动数据洞察\n   206→- **平均互动率**: {analysis['avg_engagement_rate']:.2%}\n   207→- **高互动特征**: 实用性强、可操作性高的内容互动率更高\n   208→- **收藏/点赞比**: 收藏率高的内容往往是工具型、清单型选题\n   209→\n   210→#### 🎯 爆款选题规律\n   211→\n   212→**1. 时效型选题** （抓住时间节点）\n   213→- 特征：结合当下热点、节日、年度规划\n   214→- 关键词：\"2026\"、\"新年\"、\"年度计划\"\n   215→- 流量密码：时间紧迫感 + 情感共鸣\n   216→\n   217→**2. 教程型选题** （降低认知门槛）\n   218→- 特征：具体数字 + 步骤化教程\n   219→- 关键词：\"X分钟看懂\"、\"X步教你\"、\"零基础\"\n   220→- 流量密码：简单易懂 + 即学即用\n   221→\n   222→**3. 情绪型选题** （制造讨论点）\n   223→- 特征：观点鲜明、引发共鸣或争议\n   224→- 关键词：\"底气\"、\"心安\"、\"焦虑\"\n   225→- 流量密码：情感共鸣 + 价值认同\n   226→\n   227→**4. 清单型选题** （提供行动指南）\n   228→- 特征：可执行的具体建议清单\n   229→- 关键词：\"X件事\"、\"X个方法\"、\"必做清单\"\n   230→- 流量密码：具体可操作 + 人群标签\n   231→\n   232→─────────────────────────────────────────\n   233→\n   234→### 💡 选题建议（可直接使用）\n   235→\n   236→#### 🎯 秒懂金融小知识系列\n   237→\n   238→1. **\"1分钟看懂银行利率陷阱，存钱前必看\"**\n   239→   - 切入点：用具体案例对比不同存款方式的收益差异\n   240→   - 目标人群：理财小白、存款新手\n   241→   - 内容要点：3-4个常见误区 + 正确做法\n   242→\n   243→2. **\"A股代码背后的秘密，新手必知的5个规则\"**\n   244→   - 切入点：代码数字含义、板块分类、交易规则\n   245→   - 目标人群：股市新手、想入门的观望者\n   246→   - 内容要点：用表格或图示展示，简单易记\n   247→\n   248→3. **\"基金定投的黄金法则：3个时间点+2个止盈策略\"**\n   249→   - 切入点：具体的定投时机选择和退出策略\n   250→   - 目标人群：基金定投新手\n   251→   - 内容要点：用实际数据说明，可复制性强\n   252→\n   253→#### 🎯 每天秒懂财经热点系列\n   254→\n   255→1. **\"美联储降息对你钱包的3个直接影响\"**\n   256→   - 切入点：宏观政策与个人理财的连接\n   257→   - 目标人群：关注财经但不懂宏观的普通人\n   258→   - 内容要点：房贷、存款、汇率3个维度\n   259→\n   260→2. **\"2026年这3个理财方向值得关注\"**\n   261→   - 切入点：年度规划 + 趋势预判\n   262→   - 目标人群：想做年度理财规划的人\n   263→   - 内容要点：结合政策、市场、个人需求\n   264→\n   265→3. **\"通货膨胀下，普通人如何保护资产？\"**\n   266→   - 切入点：当下痛点 + 实用建议\n   267→   - 目标人群：担心财富缩水的中等收入群体\n   268→   - 内容要点：3-5个具体可行的方法\n   269→\n   270→#### 🎯 秒懂理财小技巧系列\n   271→\n   272→1. **\"月薪5000的存钱法：6个月存下2万\"**\n   273→   - 切入点：具体收入 + 可实现的目标\n   274→   - 目标人群：打工人、低收入想存钱的人\n   275→   - 内容要点：预算分配 + 记账技巧 + 节流方法\n   276→\n   277→2. **\"女生理财必做的8件事，30岁前财务自由\"**\n   278→   - 切入点：性别标签 + 年龄节点 + 诱人目标\n   279→   - 目标人群：20-30岁女性\n   280→   - 内容要点：从基础到进阶的理财清单\n   281→\n   282→3. **\"打工人副业理财两不误：时间管理+钱生钱\"**\n   283→   - 切入点：双重焦虑（时间+金钱）的解决方案\n   284→   - 目标人群：想开副业的上班族\n   285→   - 内容要点：时间分配 + 理财规划 + 风险控制\n   286→\n   287→─────────────────────────────────────────\n   288→\n   289→### ⚠️ 内容创作要点\n   290→\n   291→**标题撰写技巧**：\n   292→1. 使用具体数字（\"3个\"、\"5000元\"、\"30天\"）\n   293→2. 明确目标人群（\"女生\"、\"新手\"、\"打工人\"）\n   294→3. 突出价值点（\"必看\"、\"必做\"、\"黄金法则\"）\n   295→4. 制造紧迫感（\"年前\"、\"2026\"、\"别错过\"）\n   296→\n   297→**内容结构建议**：\n   298→1. 开头：痛点引入或案例故事（50字内）\n   299→2. 中间：3-5个要点，用小标题分段\n   300→3. 结尾：总结 + 行动呼吁\n   301→4. 配图：清晰的图表、对比图、步骤图\n   302→\n   303→**风险提示**：\n   304→• 避免承诺具体收益率（合规风险）\n   305→• 数据引用需标注来源\n   306→• 涉及股票、基金需加免责声明\n   307→• 时效性内容注明时间范围\n   308→\n   309→─────────────────────────────────────────\n   310→\n   311→### 📋 完整爆款笔记列表 ({len(hits)}条)\n   312→\n   313→\"\"\"\n   314→\n   315→    # 列出所有符合条件的笔记\n   316→    for i, note in enumerate(hits, 1):\n   317→        title = note['title']\n   318→        likes = format_number(note['likes'])\n   319→        author = note['author']\n   320→        url = note['url']\n   321→\n   322→        content += f\"{i}. **{title}** ({likes}赞) - @{author}\\n\"\n   323→        content += f\"   {url}\\n\\n\"\n   324→\n   325→    content += f\"\"\"\n   326→─────────────────────────────────────────\n   327→\n   328→📊 本次共筛选出 **{len(hits)} 条**爆款笔记\n   329→📅 数据时间：{today}\n   330→⏰ 抓取时间：{datetime.now().strftime(\"%H:%M:%S\")}\n   331→\"\"\"\n   332→\n   333→    return content\n   334→\n   335→\n   336→def cleanup_temp_files():\n   337→    \"\"\"清理临时数据文件\"\"\"\n   338→    base_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n   339→    files_to_clean = ['data.json', 'fans.json']\n   340→\n   341→    cleaned = []\n   342→    for filename in files_to_clean:\n   343→        filepath = os.path.join(base_dir, filename)\n   344→        if os.path.exists(filepath):\n   345→            try:\n   346→                os.remove(filepath)\n   347→                cleaned.append(filename)\n   348→                print(f\"[Cleanup] 已删除临时文件: {filename}\")\n   349→            except Exception as e:\n   350→                print(f\"[Warning] 删除 {filename} 失败: {e}\")\n   351→\n   352→    if cleaned:\n   353→        print(f\"[Cleanup] 清理完成，共删除 {len(cleaned)} 个文件\")\n   354→    else:\n   355→        print(\"[Cleanup] 没有需要清理的临时文件\")\n   356→\n   357→\n   358→def push_to_wechat(token, content):\n   359→    \"\"\"推送内容到微信\"\"\"\n   360→    today = datetime.now().strftime(\"%m-%d\")\n   361→    title = f\"💰 小红书财经猎手 {today}\"\n   362→\n   363→    url = 'http://www.pushplus.plus/send'\n   364→    data = {\n   365→        \"token\": token,\n   366→        \"title\": title,\n   367→        \"content\": content,\n   368→        \"template\": \"markdown\"\n   369→    }\n   370→\n   371→    try:\n   372→        response = requests.post(url, json=data, timeout=30)\n   373→        res_json = response.json()\n   374→        if res_json.get(\"code\") == 200:\n   375→            print(\"[Success] 推送成功！请检查手机。\")\n   376→            return True\n   377→        else:\n   378→            print(f\"[Failed] {res_json.get('msg')}\")\n   379→            return False\n   380→    except Exception as e:\n   381→        print(f\"[Error] {e}\")\n   382→        return False\n   383→\n   384→\n   385→if __name__ == \"__main__\":\n   386→    parser = argparse.ArgumentParser()\n   387→    parser.add_argument('--token', help='PushPlus Token')\n   388→    parser.add_argument('--file', required=True, help='Data JSON file')\n   389→    parser.add_argument('--no-cleanup', action='store_true', help='不清理临时文件（调试用）')\n   390→    args = parser.parse_args()\n   391→\n   392→    token = args.token\n   393→    if not token:\n   394→        config = load_config()\n   395→        token = config.get('wechat_push_token')\n   396→\n   397→    if not token:\n   398→        print(\"Error: No token provided\")\n   399→        sys.exit(1)\n   400→\n   401→    content = generate_content(args.file)\n   402→    success = push_to_wechat(token, content)\n   403→\n   404→    # 推送成功后清理临时文件（除非指定 --no-cleanup）\n   405→    if success and not args.no_cleanup:\n   406→        cleanup_temp_files()\n   407→\n   408→    sys.exit(0 if success else 1)\n   409→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"uuid":"9d145235-f9ce-4258-a1cd-12fdb95a3176","timestamp":"2026-01-20T01:34:45.285Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/henry/.claude/skills/xhs-topic-analyzer/scripts/push_report.py","content":"# -*- coding: utf-8 -*-\n\"\"\"\n推送小红书热点选题报告到微信 (V8.1 - 深度选题分析)\n专注财经赛道：3天内 + 2000赞以上\n\"\"\"\nimport requests\nimport argparse\nimport os\nimport sys\nimport json\nfrom datetime import datetime\nfrom collections import Counter\n\n\ndef load_config():\n    \"\"\"加载配置文件\"\"\"\n    config_path = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), 'config.json')\n    if os.path.exists(config_path):\n        try:\n            with open(config_path, 'r', encoding='utf-8') as f:\n                return json.load(f)\n        except Exception as e:\n            print(f\"[Warning] Config load failed: {e}\")\n    return {}\n\n\ndef format_number(num):\n    \"\"\"格式化数字\"\"\"\n    try:\n        num = int(num)\n    except (ValueError, TypeError):\n        num = 0\n    if num >= 10000:\n        return f\"{num/10000:.1f}万\"\n    return str(num)\n\n\ndef load_data(data_file):\n    \"\"\"加载数据\"\"\"\n    with open(data_file, 'r', encoding='utf-8') as f:\n        raw_data = json.load(f)\n\n    if isinstance(raw_data, dict) and \"feeds\" in raw_data:\n        raw_data = raw_data[\"feeds\"]\n\n    flat_data = []\n    for item in raw_data:\n        if \"noteCard\" in item:\n            card = item[\"noteCard\"]\n            flat_item = {\n                \"id\": item.get('id', ''),\n                \"title\": card.get(\"displayTitle\", \"\") or \"无标题\",\n                \"author\": card.get(\"user\", {}).get(\"nickname\", \"\"),\n                \"likes\": card.get(\"interactInfo\", {}).get(\"likedCount\", 0),\n                \"collects\": card.get(\"interactInfo\", {}).get(\"collectedCount\", 0),\n                \"comments\": card.get(\"interactInfo\", {}).get(\"commentCount\", 0),\n                \"url\": f\"https://www.xiaohongshu.com/explore/{item.get('id', '')}\"\n            }\n            flat_data.append(flat_item)\n        else:\n            # 支持新格式（nickname）和旧格式（author）\n            flat_item = {\n                \"id\": item.get('id', ''),\n                \"title\": item.get('title', '无标题'),\n                \"author\": item.get('nickname') or item.get('author', ''),\n                \"likes\": item.get('likedCount', 0) or item.get('likes', 0),\n                \"collects\": item.get('collectedCount', 0),\n                \"comments\": item.get('commentCount', 0),\n                \"url\": f\"https://www.xiaohongshu.com/explore/{item.get('id', '')}\"\n            }\n            flat_data.append(flat_item)\n\n    return flat_data\n\n\ndef analyze_topics(notes):\n    \"\"\"深度分析选题类型和特征\"\"\"\n\n    # 关键词分类\n    topic_keywords = {\n        \"理财技巧\": [\"存钱\", \"攒钱\", \"理财\", \"财富\", \"资产\", \"收益\"],\n        \"金融知识\": [\"金融\", \"银行\", \"利率\", \"通货\", \"货币\", \"经济\"],\n        \"投资教程\": [\"股票\", \"基金\", \"投资\", \"买入\", \"卖出\", \"持仓\", \"A股\"],\n        \"财经热点\": [\"政策\", \"美国\", \"中国\", \"市场\", \"新闻\", \"分析\", \"观点\"],\n        \"理财心态\": [\"心安\", \"底气\", \"焦虑\", \"稳定\", \"长期\", \"规划\"],\n        \"生活理财\": [\"女生\", \"打工人\", \"年轻人\", \"新手\", \"小白\", \"入门\"],\n    }\n\n    topic_counts = {topic: 0 for topic in topic_keywords.keys()}\n    topic_examples = {topic: [] for topic in topic_keywords.keys()}\n\n    for note in notes:\n        title = note['title'].lower()\n        matched = False\n        for topic, keywords in topic_keywords.items():\n            if any(kw in title for kw in keywords):\n                topic_counts[topic] += 1\n                if len(topic_examples[topic]) < 3:  # 每个类型最多保存3个例子\n                    topic_examples[topic].append({\n                        'title': note['title'],\n                        'likes': note['likes']\n                    })\n                matched = True\n                break\n\n    # 标题长度分析\n    title_lengths = [len(note['title']) for note in notes]\n    avg_length = sum(title_lengths) / len(title_lengths) if title_lengths else 0\n\n    # 互动率分析\n    engagement_rates = []\n    for note in notes:\n        if note['likes'] > 0:\n            engagement = (note['comments'] + note['collects']) / note['likes']\n            engagement_rates.append(engagement)\n\n    avg_engagement = sum(engagement_rates) / len(engagement_rates) if engagement_rates else 0\n\n    return {\n        'topic_distribution': topic_counts,\n        'topic_examples': topic_examples,\n        'avg_title_length': avg_length,\n        'avg_engagement_rate': avg_engagement\n    }\n\n\ndef generate_content(data_file):\n    \"\"\"生成推送内容（V8.1 - 深度分析版）\"\"\"\n    raw_data = load_data(data_file)\n\n    # 财经赛道爆款标准：2000赞以上\n    min_likes = 2000\n    hits = []\n\n    for note in raw_data:\n        likes = int(note.get('likes', 0))\n        if likes >= min_likes:\n            hits.append(note)\n\n    # 按点赞排序\n    hits = sorted(hits, key=lambda x: x['likes'], reverse=True)\n\n    # 深度分析\n    analysis = analyze_topics(hits)\n\n    today = datetime.now().strftime(\"%Y-%m-%d\")\n\n    # ========== 开始构建报告 ==========\n    content = f\"\"\"## 💰 小红书财经爆款选题日报\n\n**📅 {today}** | 筛选：点赞≥2000 | 时间：3天内 | 共 {len(hits)} 条\n\n─────────────────────────────────────────\n\n### 📊 TOP 10 热点选题\n\n\"\"\"\n\n    # TOP 10 笔记\n    top10 = hits[:10]\n    for i, note in enumerate(top10, 1):\n        title = note['title']\n        likes = format_number(note['likes'])\n        collects = format_number(note['collects'])\n        comments = format_number(note['comments'])\n        author = note['author']\n        url = note['url']\n\n        content += f\"**【第{i}名】** {title}\\n\"\n        content += f\"❤️ {likes}  |  ⭐ {collects}  |  💬 {comments}  |  @{author}\\n\"\n        content += f\"🔗 {url}\\n\\n\"\n\n    # ========== 选题分布分析 ==========\n    content += \"\"\"\n─────────────────────────────────────────\n\n### 📈 选题分布分析\n\n\"\"\"\n\n    sorted_topics = sorted(analysis['topic_distribution'].items(),\n                          key=lambda x: x[1], reverse=True)\n\n    for topic, count in sorted_topics:\n        if count > 0:\n            percentage = (count / len(hits)) * 100\n            content += f\"**{topic}**: {count}条 ({percentage:.1f}%)\\n\"\n            # 展示该类型的代表性笔记\n            if analysis['topic_examples'][topic]:\n                example = analysis['topic_examples'][topic][0]\n                content += f\"  └ 代表：「{example['title']}」({format_number(example['likes'])}赞)\\n\"\n            content += \"\\n\"\n\n    # ========== 深度选题洞察 ==========\n    content += f\"\"\"\n─────────────────────────────────────────\n\n### 🔍 深度选题洞察\n\n#### 📝 标题特征分析\n- **平均标题长度**: {analysis['avg_title_length']:.0f} 字\n- **最佳长度区间**: 15-25字（易读性与信息量平衡）\n- **标题公式**: 数字+动作词+目标人群+价值点\n\n#### 💬 互动数据洞察\n- **平均互动率**: {analysis['avg_engagement_rate']:.2%}\n- **高互动特征**: 实用性强、可操作性高的内容互动率更高\n- **收藏/点赞比**: 收藏率高的内容往往是工具型、清单型选题\n\n#### 🎯 爆款选题规律\n\n**1. 时效型选题** （抓住时间节点）\n- 特征：结合当下热点、节日、年度规划\n- 关键词：\"2026\"、\"新年\"、\"年度计划\"\n- 流量密码：时间紧迫感 + 情感共鸣\n\n**2. 教程型选题** （降低认知门槛）\n- 特征：具体数字 + 步骤化教程\n- 关键词：\"X分钟看懂\"、\"X步教你\"、\"零基础\"\n- 流量密码：简单易懂 + 即学即用\n\n**3. 情绪型选题** （制造讨论点）\n- 特征：观点鲜明、引发共鸣或争议\n- 关键词：\"底气\"、\"心安\"、\"焦虑\"\n- 流量密码：情感共鸣 + 价值认同\n\n**4. 清单型选题** （提供行动指南）\n- 特征：可执行的具体建议清单\n- 关键词：\"X件事\"、\"X个方法\"、\"必做清单\"\n- 流量密码：具体可操作 + 人群标签\n\n─────────────────────────────────────────\n\n### 💡 选题建议（可直接使用）\n\n#### 🎯 秒懂金融小知识系列\n\n1. **\"1分钟看懂银行利率陷阱，存钱前必看\"**\n   - 切入点：用具体案例对比不同存款方式的收益差异\n   - 目标人群：理财小白、存款新手\n   - 内容要点：3-4个常见误区 + 正确做法\n\n2. **\"A股代码背后的秘密，新手必知的5个规则\"**\n   - 切入点：代码数字含义、板块分类、交易规则\n   - 目标人群：股市新手、想入门的观望者\n   - 内容要点：用表格或图示展示，简单易记\n\n3. **\"基金定投的黄金法则：3个时间点+2个止盈策略\"**\n   - 切入点：具体的定投时机选择和退出策略\n   - 目标人群：基金定投新手\n   - 内容要点：用实际数据说明，可复制性强\n\n#### 🎯 每天秒懂财经热点系列\n\n1. **\"美联储降息对你钱包的3个直接影响\"**\n   - 切入点：宏观政策与个人理财的连接\n   - 目标人群：关注财经但不懂宏观的普通人\n   - 内容要点：房贷、存款、汇率3个维度\n\n2. **\"2026年这3个理财方向值得关注\"**\n   - 切入点：年度规划 + 趋势预判\n   - 目标人群：想做年度理财规划的人\n   - 内容要点：结合政策、市场、个人需求\n\n3. **\"通货膨胀下，普通人如何保护资产？\"**\n   - 切入点：当下痛点 + 实用建议\n   - 目标人群：担心财富缩水的中等收入群体\n   - 内容要点：3-5个具体可行的方法\n\n#### 🎯 秒懂理财小技巧系列\n\n1. **\"月薪5000的存钱法：6个月存下2万\"**\n   - 切入点：具体收入 + 可实现的目标\n   - 目标人群：打工人、低收入想存钱的人\n   - 内容要点：预算分配 + 记账技巧 + 节流方法\n\n2. **\"女生理财必做的8件事，30岁前财务自由\"**\n   - 切入点：性别标签 + 年龄节点 + 诱人目标\n   - 目标人群：20-30岁女性\n   - 内容要点：从基础到进阶的理财清单\n\n3. **\"打工人副业理财两不误：时间管理+钱生钱\"**\n   - 切入点：双重焦虑（时间+金钱）的解决方案\n   - 目标人群：想开副业的上班族\n   - 内容要点：时间分配 + 理财规划 + 风险控制\n\n─────────────────────────────────────────\n\n### ⚠️ 内容创作要点\n\n**标题撰写技巧**：\n1. 使用具体数字（\"3个\"、\"5000元\"、\"30天\"）\n2. 明确目标人群（\"女生\"、\"新手\"、\"打工人\"）\n3. 突出价值点（\"必看\"、\"必做\"、\"黄金法则\"）\n4. 制造紧迫感（\"年前\"、\"2026\"、\"别错过\"）\n\n**内容结构建议**：\n1. 开头：痛点引入或案例故事（50字内）\n2. 中间：3-5个要点，用小标题分段\n3. 结尾：总结 + 行动呼吁\n4. 配图：清晰的图表、对比图、步骤图\n\n**风险提示**：\n• 避免承诺具体收益率（合规风险）\n• 数据引用需标注来源\n• 涉及股票、基金需加免责声明\n• 时效性内容注明时间范围\n\n─────────────────────────────────────────\n\n### 📋 完整爆款笔记列表 ({len(hits)}条)\n\n\"\"\"\n\n    # 列出所有符合条件的笔记\n    for i, note in enumerate(hits, 1):\n        title = note['title']\n        likes = format_number(note['likes'])\n        author = note['author']\n        url = note['url']\n\n        content += f\"{i}. **{title}** ({likes}赞) - @{author}\\n\"\n        content += f\"   {url}\\n\\n\"\n\n    content += f\"\"\"\n─────────────────────────────────────────\n\n📊 本次共筛选出 **{len(hits)} 条**爆款笔记\n📅 数据时间：{today}\n⏰ 抓取时间：{datetime.now().strftime(\"%H:%M:%S\")}\n\"\"\"\n\n    return content\n\n\ndef cleanup_temp_files():\n    \"\"\"清理临时数据文件\"\"\"\n    base_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n    files_to_clean = ['data.json', 'fans.json']\n\n    cleaned = []\n    for filename in files_to_clean:\n        filepath = os.path.join(base_dir, filename)\n        if os.path.exists(filepath):\n            try:\n                os.remove(filepath)\n                cleaned.append(filename)\n                print(f\"[Cleanup] 已删除临时文件: {filename}\")\n            except Exception as e:\n                print(f\"[Warning] 删除 {filename} 失败: {e}\")\n\n    if cleaned:\n        print(f\"[Cleanup] 清理完成，共删除 {len(cleaned)} 个文件\")\n    else:\n        print(\"[Cleanup] 没有需要清理的临时文件\")\n\n\ndef push_to_wechat(token, content):\n    \"\"\"推送内容到微信\"\"\"\n    today = datetime.now().strftime(\"%m-%d\")\n    title = f\"💰 小红书财经猎手 {today}\"\n\n    url = 'http://www.pushplus.plus/send'\n    data = {\n        \"token\": token,\n        \"title\": title,\n        \"content\": content,\n        \"template\": \"markdown\"\n    }\n\n    try:\n        response = requests.post(url, json=data, timeout=30)\n        res_json = response.json()\n        if res_json.get(\"code\") == 200:\n            print(\"[Success] 推送成功！请检查手机。\")\n            return True\n        else:\n            print(f\"[Failed] {res_json.get('msg')}\")\n            return False\n    except Exception as e:\n        print(f\"[Error] {e}\")\n        return False\n\n\nif __name__ == \"__main__\":\n    parser = argparse.ArgumentParser()\n    parser.add_argument('--token', help='PushPlus Token')\n    parser.add_argument('--file', required=True, help='Data JSON file')\n    parser.add_argument('--no-cleanup', action='store_true', help='不清理临时文件（调试用）')\n    args = parser.parse_args()\n\n    token = args.token\n    if not token:\n        config = load_config()\n        token = config.get('wechat_push_token')\n\n    if not token:\n        print(\"Error: No token provided\")\n        sys.exit(1)\n\n    content = generate_content(args.file)\n    success = push_to_wechat(token, content)\n\n    # 推送成功后清理临时文件（除非指定 --no-cleanup）\n    if success and not args.no_cleanup:\n        cleanup_temp_files()\n\n    sys.exit(0 if success else 1)\n","numLines":409,"startLine":1,"totalLines":409}},"sourceToolAssistantUUID":"bf7b31bd-3c79-4dc2-b8ee-383b707c8232"}
