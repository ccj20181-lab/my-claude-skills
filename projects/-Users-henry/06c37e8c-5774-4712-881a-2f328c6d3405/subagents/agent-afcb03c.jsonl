    52→            echo \"等待中... ($i/10)\"\n    53→            sleep 2\n    54→          done\n    55→\n    56→          # 检查是否成功启动\n    57→          if ! curl -s http://localhost:3000/health > /dev/null 2>&1; then\n    58→            echo \"✗ MCP Server 启动失败，查看日志：\"\n    59→            cat /tmp/mcp_server.log\n    60→            exit 1\n    61→          fi\n    62→\n    63→      - name: 运行低粉爆文分析\n    64→        run: |\n    65→          python scripts/viral_finder.py --config config.viral.json\n    66→        env:\n    67→          WECHAT_PUSH_TOKEN: ${{ secrets.WECHAT_PUSH_TOKEN }}\n    68→\n    69→      - name: 上传 Excel 报告\n    70→        if: success()\n    71→        uses: actions/upload-artifact@v4\n    72→        with:\n    73→          name: viral-report-${{ github.run_number }}\n    74→          path: ~/Documents/小红书爆文分析_*.xlsx\n    75→          retention-days: 30\n    76→\n    77→      - name: 上传 JSON 数据\n    78→        if: success()\n    79→        uses: actions/upload-artifact@v4\n    80→        with:\n    81→          name: viral-report-${{ github.run_number }}\n    82→          path: ~/Documents/xhs_viral_notes_*.json\n    83→          retention-days: 30\n    84→\n    85→      - name: 清理\n    86→        if: always()\n    87→        run: |\n    88→          pkill -f xiaohongshu-mcp || true\n    89→          rm -f /tmp/xhs_cookies.json\n    90→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"uuid":"4f547ac4-5296-4f13-b1e1-bede39741bd5","timestamp":"2026-01-20T01:34:48.075Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/henry/.claude/skills/xhs-topic-analyzer/.github/workflows/xhs-viral-report.yml","content":"name: 小红书低粉爆文日报\n\non:\n  # 定时触发：每天北京时间 10:30 (UTC 02:30)\n  schedule:\n    - cron: '30 2 * * *'\n\n  # 手动触发\n  workflow_dispatch:\n\nenv:\n  WECHAT_PUSH_TOKEN: ${{ secrets.WECHAT_PUSH_TOKEN }}\n  XHS_COOKIES: ${{ secrets.XHS_COOKIES }}\n\njobs:\n  viral-finder:\n    runs-on: ubuntu-latest\n    timeout-minutes: 30\n\n    steps:\n      - name: Checkout 代码\n        uses: actions/checkout@v4\n\n      - name: 设置 Python 环境\n        uses: actions/setup-python@v5\n        with:\n          python-version: '3.11'\n          cache: 'pip'\n\n      - name: 安装依赖\n        run: |\n          pip install --upgrade pip\n          pip install -r requirements.txt\n\n      - name: 准备小红书 Cookies\n        run: |\n          echo '${{ secrets.XHS_COOKIES }}' > /tmp/xhs_cookies.json\n          echo \"✓ Cookies 文件已创建\"\n\n      - name: 启动 xiaohongshu-mcp Server\n        run: |\n          echo \"启动 MCP Server...\"\n          nohup xiaohongshu-mcp serve --port 3000 --cookies /tmp/xhs_cookies.json > /tmp/mcp_server.log 2>&1 &\n\n          # 等待服务启动\n          echo \"等待 MCP Server 启动...\"\n          for i in {1..10}; do\n            if curl -s http://localhost:3000/health > /dev/null 2>&1; then\n              echo \"✓ MCP Server 已就绪\"\n              break\n            fi\n            echo \"等待中... ($i/10)\"\n            sleep 2\n          done\n\n          # 检查是否成功启动\n          if ! curl -s http://localhost:3000/health > /dev/null 2>&1; then\n            echo \"✗ MCP Server 启动失败，查看日志：\"\n            cat /tmp/mcp_server.log\n            exit 1\n          fi\n\n      - name: 运行低粉爆文分析\n        run: |\n          python scripts/viral_finder.py --config config.viral.json\n        env:\n          WECHAT_PUSH_TOKEN: ${{ secrets.WECHAT_PUSH_TOKEN }}\n\n      - name: 上传 Excel 报告\n        if: success()\n        uses: actions/upload-artifact@v4\n        with:\n          name: viral-report-${{ github.run_number }}\n          path: ~/Documents/小红书爆文分析_*.xlsx\n          retention-days: 30\n\n      - name: 上传 JSON 数据\n        if: success()\n        uses: actions/upload-artifact@v4\n        with:\n          name: viral-report-${{ github.run_number }}\n          path: ~/Documents/xhs_viral_notes_*.json\n          retention-days: 30\n\n      - name: 清理\n        if: always()\n        run: |\n          pkill -f xiaohongshu-mcp || true\n          rm -f /tmp/xhs_cookies.json\n","numLines":90,"startLine":1,"totalLines":90}},"sourceToolAssistantUUID":"bcaa5282-6852-4bd4-9dec-dd75acce96ee"}
