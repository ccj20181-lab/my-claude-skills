        },
        {
          "name": "report",
          "path": "assets/icons/财务报表_白板手绘.png"
        }
      ],
      "audio": {
        "path": "audio/scene_10.mp3",
        "duration_ms": 12672,
        "word_timestamps": null
      }
    },
    {
      "id": "scene_11",
      "type": "summary",
      "text": "总结一下，ETF就是一种可以像股票一样交易的指数基金，帮你一键分散投资，费用低，交易灵活，特别适合普通投资者！",
      "duration": 9.312,
