# Finance Infographic Configuration Template
# Copy this file to config.yaml (project level) or ~/.finance-infographic/config.yaml (user level)

api:
  # Provider: 'google' or 'nanobanana'
  provider: nanobanana

  # API Keys (Can also be set via environment variables: GOOGLE_API_KEY, NANO_BANANA_API_KEY)
  # google_key: "YOUR_GOOGLE_API_KEY"
  # google_url: "https://generativelanguage.googleapis.com/v1beta/models/gemini-3-pro-image-preview:generateContent"

  # nanobanana_key: "YOUR_NANOBANANA_KEY"
  # nanobanana_url: "https://api.apiyi.com/v1beta/models/gemini-3-pro-image-preview:generateContent"

  timeout: 180

output:
  # Base output directory. Can be absolute or relative to project root.
  # Defaults to 'output' folder in the project directory if not specified.
  # Can also be set via env var: FINANCE_OUTPUT_DIR
  base_dir: "/Users/henry/Desktop/秒懂金融学院/信息图输出"

  # Target resolution for generation (1K, 2K, 4K)
  resolution: "4K"
