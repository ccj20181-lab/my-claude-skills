# Finance Infographic Generator - Environment Variables Template
# Copy this file to .env and fill in your API keys
# ⚠️ NEVER commit .env with real keys to version control!

# ==============================================================================
# API Configuration
# ==============================================================================

# API Priority: 1 = API易 (recommended), 2 = Google
API_PRIORITY=1

# API易 Nano Banana Pro
# Get your key from: https://apiyi.com
NANO_BANANA_API_KEY=your_api_key_here
NANO_BANANA_API_URL=https://api.apiyi.com/v1beta/models/gemini-3-pro-image-preview:generateContent

# Google API (Backup)
# Get your key from: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_key_here
GOOGLE_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3-pro-image-preview:generateContent

# ==============================================================================
# Output Configuration (Optional)
# ==============================================================================

# Output directory (optional, can also be set in config.yaml)
# FINANCE_OUTPUT_DIR=/path/to/output

# ==============================================================================
# Logging Configuration (Optional)
# ==============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO
