# -*- coding: utf-8 -*-
"""
数据完整性校验脚本
在执行推送前验证数据质量

使用方法：
    python scripts/validate_data.py data.json

校验内容：
1. data.json 是否存在且格式正确
2. 每条笔记是否包含必需字段
3. 粉丝数据是否完整（来源统计）
4. 筛选条件是否能匹配到足够的笔记
"""
import json
import sys
import os
from datetime import datetime

# 解决 Windows 控制台编码问题
if os.name == 'nt':
    import io
    sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8', errors='replace')


def validate_data_file(data_file, mode='finance-pro'):
    """
    校验 data.json 数据完整性

    Args:
        data_file: 数据文件路径
        mode: 模式 (finance-pro 或 lite)

    Returns:
        dict: 校验结果
    """
    print("=" * 60)
    print("📊 数据完整性校验")
    print("=" * 60)

    result = {
        'status': 'success',
        'errors': [],
        'warnings': [],
        'stats': {}
    }

    # 1. 检查文件是否存在
    print(f"\n[步骤1] 检查文件: {data_file}")
    if not os.path.exists(data_file):
        result['status'] = 'error'
        result['errors'].append(f"文件不存在: {data_file}")
        print(f"  ❌ 文件不存在")
        return result
    print(f"  ✅ 文件存在")

    # 2. 读取并解析 JSON
    print(f"\n[步骤2] 解析 JSON")
    try:
        with open(data_file, 'r', encoding='utf-8') as f:
            data = json.load(f)
        print(f"  ✅ JSON 解析成功")
    except json.JSONDecodeError as e:
        result['status'] = 'error'
        result['errors'].append(f"JSON 解析失败: {e}")
        print(f"  ❌ JSON 解析失败: {e}")
        return result

    # 3. 检查数据结构
    print(f"\n[步骤3] 检查数据结构")
    if isinstance(data, dict) and 'feeds' in data:
        feeds = data['feeds']
        print(f"  ✅ 标准格式 ({{feeds: [...]}}) ")
    elif isinstance(data, list):
        feeds = data
        print(f"  ⚠️ 列表格式 ([...])")
        result['warnings'].append("数据格式为列表，建议使用标准格式 {feeds: [...]}")
    else:
        result['status'] = 'error'
        result['errors'].append("不支持的数据格式")
        print(f"  ❌ 不支持的数据格式")
        return result

    result['stats']['total_feeds'] = len(feeds)
    print(f"  📝 笔记总数: {len(feeds)}")

    # 4. 检查每条笔记的必需字段
    print(f"\n[步骤4] 检查笔记字段")
    required_fields = ['id', 'noteCard']
    required_user_fields = ['userId', 'nickname']
    required_interact_fields = ['likedCount']

    field_stats = {
        'has_fans': 0,
        'fans_zero': 0,
        'fans_missing': 0,
        'likes_valid': 0,
        'user_valid': 0
    }

    for i, feed in enumerate(feeds):
        # 检查基本字段
        note_card = feed.get('noteCard', {})
        user = note_card.get('user', {})
        interact = note_card.get('interactInfo', {})

        # 检查粉丝数据
        fans = user.get('fans', None)
        if fans is not None and fans > 0:
            field_stats['has_fans'] += 1
        elif fans == 0:
            field_stats['fans_zero'] += 1
        else:
            field_stats['fans_missing'] += 1

        # 检查点赞数
        likes = interact.get('likedCount', 0)
        if likes:
            field_stats['likes_valid'] += 1

        # 检查用户信息
        if user.get('userId') and user.get('nickname'):
            field_stats['user_valid'] += 1

    result['stats']['field_stats'] = field_stats

    print(f"  ✅ 有粉丝数据: {field_stats['has_fans']}/{len(feeds)}")
    print(f"  ⚠️ 粉丝数为0: {field_stats['fans_zero']}/{len(feeds)}")
    print(f"  ❌ 粉丝数缺失: {field_stats['fans_missing']}/{len(feeds)}")
    print(f"  📊 有效点赞数: {field_stats['likes_valid']}/{len(feeds)}")
    print(f"  👤 有效用户信息: {field_stats['user_valid']}/{len(feeds)}")

    # 警告：如果粉丝数据缺失严重
    if field_stats['fans_missing'] > len(feeds) * 0.5:
        result['warnings'].append(f"超过50%的笔记缺少粉丝数据 ({field_stats['fans_missing']}/{len(feeds)})")

    # 5. 模拟筛选
    print(f"\n[步骤5] 模拟筛选 (mode={mode})")
    if mode == 'finance-pro':
        min_likes = 1000
        max_fans = 20000
    else:
        min_likes = 500
        max_fans = float('inf')

    hits = []
    for feed in feeds:
        note_card = feed.get('noteCard', {})
        user = note_card.get('user', {})
        interact = note_card.get('interactInfo', {})

        likes = interact.get('likedCount', 0)
        if isinstance(likes, str):
            likes = int(likes)
        fans = user.get('fans', 0)
        if isinstance(fans, str):
            fans = int(fans)

        if likes >= min_likes and fans < max_fans:
            hits.append({
                'title': note_card.get('displayTitle', ''),
                'likes': likes,
                'fans': fans,
                'author': user.get('nickname', '')
            })

    result['stats']['filtered_count'] = len(hits)
    print(f"  🎯 筛选条件: 点赞>={min_likes}, 粉丝<{max_fans}")
    print(f"  ✅ 符合条件: {len(hits)} 条")

    if len(hits) < 5:
        result['warnings'].append(f"符合条件的笔记不足5条 ({len(hits)})")
        print(f"  ⚠️ 符合条件的笔记不足5条，可能影响报告质量")

    # 显示 Top 5
    if hits:
        print(f"\n  📋 Top 5 预览:")
        hits_sorted = sorted(hits, key=lambda x: x['likes'], reverse=True)[:5]
        for i, h in enumerate(hits_sorted, 1):
            print(f"    {i}. {h['title'][:30]}... | 👍{h['likes']} | 粉丝{h['fans']}")

    # 6. 总结
    print("\n" + "=" * 60)
    print("📊 校验结果")
    print("=" * 60)

    if result['errors']:
        result['status'] = 'error'
        print(f"❌ 状态: 失败")
        for e in result['errors']:
            print(f"   错误: {e}")
    elif result['warnings']:
        result['status'] = 'warning'
        print(f"⚠️ 状态: 有警告")
        for w in result['warnings']:
            print(f"   警告: {w}")
    else:
        print(f"✅ 状态: 通过")

    print(f"\n📈 统计:")
    print(f"   笔记总数: {result['stats']['total_feeds']}")
    print(f"   有粉丝数据: {field_stats['has_fans']}")
    print(f"   符合筛选条件: {result['stats']['filtered_count']}")

    return result


def main():
    if len(sys.argv) < 2:
        print("用法: python scripts/validate_data.py <data.json> [mode]")
        print("\n参数:")
        print("  data.json - 数据文件路径")
        print("  mode      - 可选，模式 (finance-pro 或 lite，默认 finance-pro)")
        print("\n示例:")
        print("  python scripts/validate_data.py data.json")
        print("  python scripts/validate_data.py data.json lite")
        sys.exit(1)

    data_file = sys.argv[1]
    mode = sys.argv[2] if len(sys.argv) > 2 else 'finance-pro'

    result = validate_data_file(data_file, mode)

    # 返回退出码
    if result['status'] == 'error':
        sys.exit(1)
    elif result['status'] == 'warning':
        sys.exit(0)  # 警告不阻止执行
    else:
        sys.exit(0)


if __name__ == "__main__":
    main()
