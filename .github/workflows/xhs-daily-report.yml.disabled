name: 小红书财经爆款日报 (直接 HTTP 版本)

on:
  # 定时触发：每天北京时间 09:00 (UTC 01:00)
  schedule:
    - cron: '0 1 * * *'

  # 手动触发
  workflow_dispatch:

env:
  XHS_COOKIES: ${{ secrets.XHS_COOKIES }}
  WECHAT_PUSH_TOKEN: ${{ secrets.WECHAT_PUSH_TOKEN }}

jobs:
  generate-report:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    defaults:
      run:
        working-directory: ./xhs-topic-analyzer

    steps:
      - name: Checkout 代码
        uses: actions/checkout@v4

      - name: 设置 Python 环境
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: 'pip'
          cache-dependency-path: '**/requirements.txt'

      - name: 安装 Python 依赖
        run: |
          pip install --upgrade pip
          pip install -r requirements.txt

      - name: 运行小红书搜索分析
        run: |
          python scripts/agent_runner.py
        env:
          XHS_COOKIES: ${{ secrets.XHS_COOKIES }}

      - name: 数据校验
        run: |
          python scripts/validate_data.py data.json

      - name: 生成报告并推送微信
        run: |
          python scripts/push_report.py --file data.json
        env:
          WECHAT_PUSH_TOKEN: ${{ secrets.WECHAT_PUSH_TOKEN }}

      - name: 上传报告数据（可选）
        if: success()
        uses: actions/upload-artifact@v4
        with:
          name: daily-report-${{ github.run_number }}
          path: xhs-topic-analyzer/data.json
          retention-days: 7

      - name: 清理
        if: always()
        run: |
          # 删除临时文件
          rm -f data.json

          echo "✓ 清理完成"

      - name: 失败通知
        if: failure()
        run: |
          # 如果执行失败，发送通知到微信
          curl -X POST http://www.pushplus.plus/send \
            -H "Content-Type: application/json" \
            -d "{
              \"token\": \"${{ secrets.WECHAT_PUSH_TOKEN }}\",
              \"title\": \"⚠️ 小红书爆款日报执行失败\",
              \"content\": \"GitHub Actions 执行失败，请查看日志: https://github.com/${{ github.repository }}/actions/runs/${{ github.run_id }}\",
              \"template\": \"markdown\"
            }" || true
