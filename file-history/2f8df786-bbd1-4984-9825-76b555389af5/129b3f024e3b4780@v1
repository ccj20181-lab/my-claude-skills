#!/usr/bin/env python3
# -*- coding: utf-8 -*-
import json

# 读取候选数据
with open("/tmp/xhs_candidates_20260113_191711.json", "r", encoding="utf-8") as f:
    data = json.load(f)
    candidates = data["candidates"]

# 提取唯一用户ID和xsec_token
unique_users = {}
for note in candidates:
    user_id = note["user_id"]
    if user_id not in unique_users:
        unique_users[user_id] = {
            "user_id": user_id,
            "user_name": note["user_name"],
            "xsec_token": note["xsec_token"],
            "notes": []
        }
    # 记录该用户的笔记
    unique_users[user_id]["notes"].append({
        "id": note["id"],
        "title": note["title"],
        "likes": note["likes"],
        "keyword": note["keyword"]
    })

print(f"去重后共有 {len(unique_users)} 个唯一用户")
print(f"\n用户列表:")
for i, (user_id, info) in enumerate(unique_users.items(), 1):
    print(f"{i}. {info['user_name']} (ID: {user_id}, 笔记数: {len(info['notes'])})")

# 保存唯一用户列表
with open("/tmp/unique_users.json", "w", encoding="utf-8") as f:
    json.dump(unique_users, f, ensure_ascii=False, indent=2)

print(f"\n✅ 唯一用户列表已保存到: /tmp/unique_users.json")
