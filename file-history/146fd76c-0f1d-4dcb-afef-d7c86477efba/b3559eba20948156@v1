**2.3 添加时间解析工具函数（可选）**

如果需要将相对时间（如"3天前"）转换为绝对时间，可以添加工具函数：

```typescript
function parseRelativeTime(timeStr: string): string {
    const now = new Date();
    const match = timeStr.match(/(\d+)(天|周|月|年|小时|分钟)前/);

    if (!match) return timeStr;

    const value = parseInt(match[1]);
    const unit = match[2];

    switch (unit) {
        case '分钟':
            return new Date(now.getTime() - value * 60 * 1000).toISOString();
        case '小时':
            return new Date(now.getTime() - value * 60 * 60 * 1000).toISOString();
        case '天':
            return new Date(now.getTime() - value * 24 * 60 * 60 * 1000).toISOString();
        case '周':
            return new Date(now.getTime() - value * 7 * 24 * 60 * 60 * 1000).toISOString();
        case '月':
            return new Date(now.setMonth(now.getMonth() - value)).toISOString();
        case '年':
            return new Date(now.setFullYear(now.getFullYear() - value)).toISOString();
        default:
            return timeStr;
    }
}
```

