#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
应用参考模板的排版格式到源文档
"""

import shutil
import os

def main():
    # 定义路径
    source_dir = "source_unpacked_new"
    template_dir = "template_unpacked"
    output_dir = "source_formatted"

    # 复制整个源文档目录到新位置
    if os.path.exists(output_dir):
        shutil.rmtree(output_dir)
    shutil.copytree(source_dir, output_dir)

    # 复制参考模板的styles.xml到源文档
    src_styles = os.path.join(template_dir, "word", "styles.xml")
    dst_styles = os.path.join(output_dir, "word", "styles.xml")
    shutil.copy2(src_styles, dst_styles)

    # 复制settings.xml（包含文档设置）
    src_settings = os.path.join(template_dir, "word", "settings.xml")
    dst_settings = os.path.join(output_dir, "word", "settings.xml")
    if os.path.exists(src_settings):
        shutil.copy2(src_settings, dst_settings)

    # 复制字体表（如果存在）
    src_fonts = os.path.join(template_dir, "word", "fontTable.xml")
    dst_fonts = os.path.join(output_dir, "word", "fontTable.xml")
    if os.path.exists(src_fonts):
        shutil.copy2(src_fonts, dst_fonts)

    print(f"✓ 格式应用完成！")
    print(f"✓ 输出目录: {output_dir}")

if __name__ == "__main__":
    main()
