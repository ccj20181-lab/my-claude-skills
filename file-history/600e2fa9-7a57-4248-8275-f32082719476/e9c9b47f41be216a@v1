const pptxgen = require('pptxgenjs');
const html2pptx = require('/Users/henry/.claude/plugins/cache/anthropic-agent-skills/document-skills/69c0b1a06741/skills/pptx/scripts/html2pptx.js');
const path = require('path');

async function createPresentation() {
    const pptx = new pptxgen();
    pptx.layout = 'LAYOUT_16x9';
    pptx.author = 'Antigravity';
    pptx.title = '秒懂金融 (Instant Understanding of Finance)';

    const slidesDir = path.join(__dirname, 'slides');
    const slideFiles = [
        'slide1.html',
        'slide2.html',
        'slide3.html',
        'slide4.html',
        'slide5.html',
        'slide6.html'
    ];

    console.log('Starting PPT generation...');

    for (const file of slideFiles) {
        const filePath = path.join(slidesDir, file);
        console.log(`Processing ${file}...`);
        try {
            await html2pptx(filePath, pptx);
        } catch (error) {
            console.error(`Error processing ${file}:`, error);
        }
    }

    const outputPath = path.join(__dirname, 'instant_finance.pptx');
    await pptx.writeFile({ fileName: outputPath });
    console.log(`Presentation created successfully at: ${outputPath}`);
}

createPresentation().catch(console.error);
