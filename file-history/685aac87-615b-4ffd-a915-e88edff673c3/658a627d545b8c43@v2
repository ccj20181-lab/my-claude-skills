
import matplotlib.pyplot as plt
import numpy as np

# Set Chinese font
plt.rcParams['font.sans-serif'] = ['Songti SC']
plt.rcParams['axes.unicode_minus'] = False

# 1. Pie Chart: 2025 H1 Enterprise Large Model Market Share (Token Consumption)
labels = ['阿里通义 (17.7%)', '字节豆包 (14.1%)', 'DeepSeek (10.3%)', '其他 (57.9%)']
sizes = [17.7, 14.1, 10.3, 57.9]
colors = ['#FF6B6B', '#4ECDC4', '#45B7D1', '#96CEB4']
explode = (0.05, 0.05, 0.05, 0)  # Explode the top 3

plt.figure(figsize=(10, 8))
patches, texts = plt.pie(sizes, explode=explode, labels=labels, colors=colors, startangle=140,
        textprops={'fontsize': 12}, labeldistance=1.1, shadow=True)

# Add a circle at the center to make it a donut chart
centre_circle = plt.Circle((0,0),0.70,fc='white')
fig = plt.gcf()
fig.gca().add_artist(centre_circle)

plt.title('2025年上半年中国企业级大模型市场份额\n(基于Token消耗量)', fontsize=16, fontweight='bold')
plt.axis('equal')
plt.tight_layout()
plt.savefig('market_share_2025.png', dpi=300)
plt.close()

# 2. Bar Chart with Line: Manufacturing AI Market Scale (2018-2025)
years = ['2018', '2024', '2025(预测)']
values = [8, 87, 140]

plt.figure(figsize=(10, 6))
bars = plt.bar(years, values, color='#6C5CE7', alpha=0.7, width=0.5, label='市场规模 (亿元)')

# Add value labels on top of bars
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height + 2,
             f'{height}', ha='center', va='bottom', fontsize=12, fontweight='bold')

# Add a trend line
x = np.arange(len(years))
plt.plot(x, values, color='#FF7675', marker='o', linewidth=2, markersize=8, linestyle='--', label='增长趋势')

plt.title('中国制造业人工智能应用市场规模趋势 (2018-2025)', fontsize=16, fontweight='bold')
plt.xlabel('年份', fontsize=12)
plt.ylabel('市场规模 (亿元)', fontsize=12)
plt.grid(axis='y', linestyle='--', alpha=0.5)
plt.legend(loc='upper left')

# Add annotation for growth
plt.annotate('爆发式增长', xy=(1, 87), xytext=(0.5, 110),
             arrowprops=dict(facecolor='black', shrink=0.05),
             fontsize=12)

plt.tight_layout()
plt.savefig('manufacturing_ai_growth.png', dpi=300)
plt.close()

print("Charts generated successfully: market_share_2025.png, manufacturing_ai_growth.png")
