
import matplotlib.pyplot as plt
import numpy as np
import matplotlib.patches as patches

# Set Chinese font
plt.rcParams['font.sans-serif'] = ['Songti SC']
plt.rcParams['axes.unicode_minus'] = False

# 1. 2025 H1 Enterprise Token Consumption Market Share (Pie Chart)
# Data source: Frost & Sullivan
def chart_market_share():
    labels = ['阿里通义 (17.7%)', '字节豆包 (14.1%)', 'DeepSeek (10.3%)', '百度文心 (9.2%)', '腾讯混元 (8.5%)', '其他 (40.2%)']
    sizes = [17.7, 14.1, 10.3, 9.2, 8.5, 40.2]
    colors = ['#FF6B6B', '#4ECDC4', '#45B7D1', '#2C3E50', '#96CEB4', '#D3D3D3']
    explode = (0.1, 0.05, 0.05, 0, 0, 0)

    plt.figure(figsize=(10, 8))
    plt.pie(sizes, explode=explode, labels=labels, colors=colors, startangle=140,
            textprops={'fontsize': 11}, shadow=True, autopct='%1.1f%%', pctdistance=0.85)

    centre_circle = plt.Circle((0,0),0.70,fc='white')
    fig = plt.gcf()
    fig.gca().add_artist(centre_circle)

    plt.title('2025年上半年中国企业级大模型市场份额 (按Token消耗量)', fontsize=16, fontweight='bold')
    plt.tight_layout()
    plt.savefig('chart1_market_share.png', dpi=300)
    plt.close()

# 2. Manufacturing AI Market Scale Trend (Bar + Line)
# Data source: Chyxx
def chart_market_scale():
    years = ['2018', '2019', '2020', '2021', '2022', '2023', '2024', '2025(E)']
    values = [8, 12, 19, 31, 48, 65, 87, 140]
    growth_rates = [0, 50, 58, 63, 54, 35, 33, 60]

    fig, ax1 = plt.subplots(figsize=(12, 6))

    bars = ax1.bar(years, values, color='#6C5CE7', alpha=0.7, label='市场规模(亿元)')
    ax1.set_ylabel('市场规模 (亿元)', fontsize=12)
    ax1.bar_label(bars, padding=3)

    ax2 = ax1.twinx()
    ax2.plot(years, growth_rates, color='#FF7675', marker='o', linewidth=2, linestyle='-', label='增长率(%)')
    ax2.set_ylabel('增长率 (%)', fontsize=12)
    ax2.set_ylim(0, 80)

    plt.title('中国制造业人工智能应用市场规模及增速 (2018-2025)', fontsize=16, fontweight='bold')
    fig.legend(loc="upper left", bbox_to_anchor=(0.1, 0.9))
    plt.tight_layout()
    plt.savefig('chart2_market_scale.png', dpi=300)
    plt.close()

