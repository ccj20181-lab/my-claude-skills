## 📞 支持

- [官方文档](https://code.claude.com/docs)
- [GitHub仓库](https://github.com/anthropics/claude-code)
- [Claude API文档](https://docs.anthropic.com)

## 更新日志
EOF

    echo "- **安装时间**: $(date)" >> "$guide_file"
    echo "- **安装版本**: Complete Edition" >> "$guide_file"

    log_success "完整使用指南已创建: $guide_file"
}

# 清理临时文件
cleanup_temp_files() {
    log_header "清理临时文件..."

    if [ -d "/tmp/claude-code-repo" ]; then
        rm -rf /tmp/claude-code-repo
        log_success "清理临时仓库文件"
    fi

    if [ -f "/tmp/marketplace.json" ]; then
        rm -f /tmp/marketplace.json
        log_success "清理临时marketplace文件"
    fi
}

# 主函数
main() {
    echo ""
    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║          Claude官方Skill完整安装器 (Complete Edition)      ║"
    echo "║                                                              ║"
    echo "║    🚀 通过克隆GitHub仓库获取完整的Skill文件               ║"
    echo "║    📦 包含所有skill文件和详细文档                           ║"
    echo "╚══════════════════════════════════════════════════════════════╝"
    echo ""

    # 清理旧安装
    cleanup_old_install

    # 克隆仓库
    if ! clone_repository; then
        log_error "无法克隆仓库，请检查网络连接"
        exit 1
    fi

    # 检查仓库结构
    if ! check_repository_structure; then
        log_error "仓库结构不正确"
        exit 1
    fi

    # 创建目录
    create_directories

    # 安装skill
    install_all_skills

    # 创建文档
    create_skill_index
    create_complete_guide

    # 清理临时文件
    cleanup_temp_files

    echo ""
    echo "🎉 恭喜！Claude官方Skill完整安装成功！"
    echo ""
    echo "📁 Skill目录: $SKILLS_DIR"
    echo "📖 完整指南: $SKILLS_DIR/COMPLETE_GUIDE.md"
    echo "📋 Skill索引: $SKILLS_DIR/SKILL_INDEX.md"
    echo "⚡ 快速参考: $SKILLS_DIR/QUICK_REFERENCE.md"
    echo ""
    echo "✨ 现在您可以享受完整的Claude官方skill功能了！"
    echo ""
    echo "💡 提示："
    echo "   - 查看 COMPLETE_GUIDE.md 了解详细使用方法"
    echo "   - 查看 SKILL_INDEX.md 浏览所有skill"
    echo "   - 编辑 skill.config.json 启用/禁用skill"
    echo ""
}

# 运行主函数
main "$@"