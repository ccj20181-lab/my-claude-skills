#!/bin/bash

# Claude官方Skill自动安装脚本
# 自动下载并安装Claude Code官方的所有skill和agent

set -e

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# 日志函数
log_info() {
    echo -e "${BLUE}ℹ️  $1${NC}"
}

log_success() {
    echo -e "${GREEN}✅ $1${NC}"
}

log_warning() {
    echo -e "${YELLOW}⚠️  $1${NC}"
}

log_error() {
    echo -e "${RED}❌ $1${NC}"
}

log_header() {
    echo -e "${PURPLE}🎯 $1${NC}"
}

# 检查依赖
check_dependencies() {
    log_header "检查系统依赖..."

    # 检查git
    if ! command -v git &> /dev/null; then
        log_error "Git未安装，请先安装Git"
        exit 1
    fi
    log_success "Git已安装"

    # 检查curl
    if ! command -v curl &> /dev/null; then
        log_error "Curl未安装，请先安装Curl"
        exit 1
    fi
    log_success "Curl已安装"

    # 检查jq
    if ! command -v jq &> /dev/null; then
        log_warning "Jq未安装，将使用简化模式"
        HAS_JQ=false
    else
        log_success "Jq已安装"
        HAS_JQ=true
    fi
}

# 创建目录
create_directories() {
    log_header "创建目录结构..."

    SKILLS_DIR="$HOME/.claude/skills"
    CLAUDE_DIR="$HOME/.claude"

    mkdir -p "$SKILLS_DIR"
    mkdir -p "$CLAUDE_DIR"

    log_success "创建目录: $SKILLS_DIR"
    echo "SKILLS_DIR=$SKILLS_DIR"
    echo "CLAUDE_DIR=$CLAUDE_DIR"
}

# 下载marketplace数据
download_marketplace() {
    log_header "下载Skill市场数据..."

    MARKETPLACE_URL="https://raw.githubusercontent.com/anthropics/claude-code/main/.claude-plugin/marketplace.json"

    if curl -s -f "$MARKETPLACE_URL" > /tmp/marketplace.json; then
        log_success "下载marketplace成功"
        return 0
    else
        log_error "下载marketplace失败"
        return 1
    fi
}

# 解析skill列表
parse_skills() {
    log_header "解析Skill列表..."

    if [ "$HAS_JQ" = true ]; then
        # 使用jq解析JSON
        SKILL_COUNT=$(jq '.plugins | length' /tmp/marketplace.json)
        log_info "找到 $SKILL_COUNT 个官方skill"

        # 提取skill信息
        jq -r '.plugins[] | "\(.name)|\(.description)|\(.category)|\(.author.name // "Unknown")"' /tmp/marketplace.json > /tmp/skills.txt
    else
        # 手动解析JSON
        log_warning "使用简化模式解析skill列表"
        SKILL_COUNT=$(grep -o '"name":' /tmp/marketplace.json | wc -l)
        log_info "找到 $SKILL_COUNT 个官方skill"

        # 简单解析名称
        grep -o '"name": "[^"]*"' /tmp/marketplace.json | sed 's/"name": "\([^"]*\)"/\1/' > /tmp/skills.txt
    fi

    log_success "Skill列表解析完成"
}

# 安装单个skill
install_skill() {
    local skill_name="$1"
    local skill_dir="$2"

    log_info "正在安装: $skill_name"

    # 创建skill目录
    mkdir -p "$skill_dir"

    # 构建原始文件URL
    base_url="https://raw.githubusercontent.com/anthropics/claude-code/main/.claude-plugin/plugins/$skill_name"

    # 下载可能存在的文件
    files_to_download=("README.md" "CLAUDE.md" "prompts.md" "skill.json" "index.js" "index.ts")

    downloaded_count=0
    for file in "${files_to_download[@]}"; do
        if curl -s -f "$base_url/$file" > "$skill_dir/$file" 2>/dev/null; then
            log_success "  下载: $file"
            ((downloaded_count++))
        fi
    done

    if [ $downloaded_count -gt 0 ]; then
        # 创建配置文件
        cat > "$skill_dir/skill.config.json" << EOF
{
  "name": "$skill_name",
  "description": "Claude官方Skill",
  "category": "official",
  "author": "Anthropic",
  "enabled": true,
  "auto_activate": false,
  "installed_at": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
}
EOF

        log_success "✅ 成功安装: $skill_name"
        return 0
    else
        log_warning "⚠️  跳过: $skill_name (无可用文件)"
        return 1
    fi
}

# 安装所有skill
install_all_skills() {
    log_header "开始安装Skill..."

    local installed_count=0
    local total_count=0

    while IFS='|' read -r skill_name skill_description skill_category skill_author || [ -n "$skill_name" ]; do
        ((total_count++))

        if [ -z "$skill_name" ]; then
            continue
        fi

        skill_dir="$SKILLS_DIR/$skill_name"

        if install_skill "$skill_name" "$skill_dir"; then
            ((installed_count++))
        fi

    done < /tmp/skills.txt

    log_success "安装完成! 成功安装: $installed_count/$total_count 个skill"

    return 0
}

# 生成配置文件
generate_config() {
    log_header "生成配置文件..."

    config_file="$CLAUDE_DIR/skills.json"

    cat > "$config_file" << 'EOF'
{
  "version": "1.0",
  "skills_directory": "HOME/.claude/skills",
  "enabled_skills": [
    "agent-sdk-dev",
    "code-review",
    "commit-commands",
    "feature-dev",
    "frontend-design",
    "plugin-dev",
    "pr-review-toolkit"
  ],
  "settings": {
    "auto_activate": false,
    "debug_mode": false
  }
}
EOF

    log_success "配置文件已生成: $config_file"
}

# 创建使用说明
create_usage_guide() {
    log_header "创建使用说明..."

    guide_file="$SKILLS_DIR/README.md"

    cat > "$guide_file" << 'EOF'
# Claude官方Skill安装指南

## 📋 已安装的Skill列表

以下是Claude Code官方开源的skill：

### 开发工具类
- **agent-sdk-dev**: Claude Agent SDK开发工具包
- **plugin-dev**: Claude Code插件开发工具包
- **feature-dev**: 功能开发工作流
- **frontend-design**: 前端界面设计

### 代码质量类
- **code-review**: 自动化代码审查
- **pr-review-toolkit**: PR审查工具包
- **security-guidance**: 安全提醒

### 工作流类
- **commit-commands**: Git提交工作流
- **hookify**: 自定义Hook创建

### 学习类
- **explanatory-output-style**: 解释性输出风格
- **learning-output-style**: 交互式学习模式

### 特殊工具
- **claude-opus-4-5-migration**: Claude版本迁移工具
- **ralph-wiggum**: 迭代开发循环

## 🚀 使用方法

### 1. 启用Skill
在Claude Code中，您可以通过以下方式使用skill：

```bash
# 直接调用skill
/skill-name

# 或者通过配置文件启用
```

### 2. 配置文件位置
- Skill目录: `~/.claude/skills/`
- 全局配置: `~/.claude/skills.json`

### 3. 查看已安装的Skill
```bash
ls -la ~/.claude/skills/
```

### 4. 更新Skill
```bash
# 重新运行安装脚本
bash install_claude_skills.sh
```

## 📚 更多信息

- [官方文档](https://code.claude.com/docs)
- [GitHub仓库](https://github.com/anthropics/claude-code)
- [Claude API文档](https://docs.anthropic.com)

## 🆘 故障排除

### Skill无法工作
1. 检查skill目录权限
2. 验证配置文件格式
3. 查看Claude Code日志

### 权限问题
```bash
chmod -R 755 ~/.claude/skills/
```

## 更新日志
EOF

    echo "" >> "$guide_file"
    echo "- 安装时间: $(date)" >> "$guide_file"
    echo "- Skill数量: $(ls -1 $SKILLS_DIR | wc -l)" >> "$guide_file"

    log_success "使用指南已创建: $guide_file"
}

# 主函数
main() {
    echo ""
    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║                Claude官方Skill自动安装器                     ║"
    echo "║                                                              ║"
    echo "║    🚀 一键安装Claude Code官方开源的所有Skill和Agent        ║"
    echo "╚══════════════════════════════════════════════════════════════╝"
    echo ""

    # 检查依赖
    check_dependencies

    # 创建目录
    create_directories

    # 下载marketplace
    if ! download_marketplace; then
        log_error "无法下载marketplace数据，请检查网络连接"
        exit 1
    fi

    # 解析skill列表
    parse_skills

    # 安装skill
    install_all_skills

    # 生成配置
    generate_config

    # 创建使用指南
    create_usage_guide

    echo ""
    echo "🎉 恭喜！Claude官方Skill安装成功！"
    echo ""
    echo "📁 Skill目录: $SKILLS_DIR"
    echo "⚙️  配置文件: $CLAUDE_DIR/skills.json"
    echo "📖 使用指南: $SKILLS_DIR/README.md"
    echo ""
    echo "✨ 现在您可以在Claude Code中享受这些强大的skill了！"
    echo ""
}

# 运行主函数
main "$@"