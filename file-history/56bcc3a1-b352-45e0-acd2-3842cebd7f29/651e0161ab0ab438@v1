#!/bin/bash

# Claude官方Skill自动安装脚本 v2.0
# 改进版本，支持正确的JSON解析

set -e

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# 日志函数
log_info() {
    echo -e "${BLUE}ℹ️  $1${NC}"
}

log_success() {
    echo -e "${GREEN}✅ $1${NC}"
}

log_warning() {
    echo -e "${YELLOW}⚠️  $1${NC}"
}

log_error() {
    echo -e "${RED}❌ $1${NC}"
}

log_header() {
    echo -e "${PURPLE}🎯 $1${NC}"
}

log_skill() {
    echo -e "${CYAN}🔧 $1${NC}"
}

# 检查依赖
check_dependencies() {
    log_header "检查系统依赖..."

    # 检查git
    if ! command -v git &> /dev/null; then
        log_error "Git未安装，请先安装Git"
        exit 1
    fi
    log_success "Git已安装"

    # 检查curl
    if ! command -v curl &> /dev/null; then
        log_error "Curl未安装，请先安装Curl"
        exit 1
    fi
    log_success "Curl已安装"

    # 检查jq
    if ! command -v jq &> /dev/null; then
        log_error "Jq未安装，请先安装Jq (brew install jq)"
        exit 1
    fi
    log_success "Jq已安装"
}

# 创建目录
create_directories() {
    log_header "创建目录结构..."

    SKILLS_DIR="$HOME/.claude/skills"
    CLAUDE_DIR="$HOME/.claude"

    mkdir -p "$SKILLS_DIR"
    mkdir -p "$CLAUDE_DIR"

    log_success "创建目录: $SKILLS_DIR"
    export SKILLS_DIR CLAUDE_DIR
}

# 下载marketplace数据
download_marketplace() {
    log_header "下载Skill市场数据..."

    MARKETPLACE_URL="https://raw.githubusercontent.com/anthropics/claude-code/main/.claude-plugin/marketplace.json"

    if curl -s -f "$MARKETPLACE_URL" > /tmp/marketplace.json; then
        log_success "下载marketplace成功"
        return 0
    else
        log_error "下载marketplace失败"
        return 1
    fi
}

# 解析skill列表
parse_skills() {
    log_header "解析Skill列表..."

    # 使用jq正确解析JSON
    SKILL_COUNT=$(jq '.plugins | length' /tmp/marketplace.json)
    log_info "找到 $SKILL_COUNT 个官方skill"

    # 提取skill详细信息
    jq -c '.plugins[]' /tmp/marketplace.json > /tmp/skills_raw.json

    # 创建简化的skill列表
    rm -f /tmp/skills_list.txt
    while IFS= read -r skill_json; do
        skill_name=$(echo "$skill_json" | jq -r '.name')
        skill_desc=$(echo "$skill_json" | jq -r '.description')
        skill_cat=$(echo "$skill_json" | jq -r '.category')
        skill_author=$(echo "$skill_json" | jq -r '.author.name // "Unknown"')
        skill_source=$(echo "$skill_json" | jq -r '.source')

        echo "$skill_name|$skill_desc|$skill_cat|$skill_author|$skill_source" >> /tmp/skills_list.txt

    done < /tmp/skills_raw.json

    log_success "Skill列表解析完成"
}

# 下载skill文件
download_skill_files() {
    local skill_name="$1"
    local skill_source="$2"
    local skill_dir="$3"

    # 构建原始文件URL
    base_url="https://raw.githubusercontent.com/anthropics/claude-code/main/.claude-plugin/$skill_source"

    # 下载可能存在的文件
    files_to_download=("README.md" "CLAUDE.md" "prompts.md" "skill.json" "index.js" "index.ts" "package.json")

    downloaded_count=0
    for file in "${files_to_download[@]}"; do
        file_url="$base_url/$file"
        if curl -s -f "$file_url" > "$skill_dir/$file" 2>/dev/null; then
            log_success "  下载: $file"
            ((downloaded_count++))
        fi
    done

    return $downloaded_count
}

# 安装单个skill
install_skill() {
    local skill_line="$1"
    local skill_dir="$2"

    IFS='|' read -r skill_name skill_desc skill_category skill_author skill_source <<< "$skill_line"

    log_skill "正在安装: $skill_name"

    # 创建skill目录
    mkdir -p "$skill_dir"

    # 下载skill文件
    if download_skill_files "$skill_name" "$skill_source" "$skill_dir"; then
        # 创建配置文件
        cat > "$skill_dir/skill.config.json" << EOF
{
  "name": "$skill_name",
  "description": "$skill_desc",
  "category": "$skill_category",
  "author": "$skill_author",
  "enabled": true,
  "auto_activate": false,
  "installed_at": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")",
  "source": "$skill_source"
}
EOF

        log_success "✅ 成功安装: $skill_name"
        return 0
    else
        log_warning "⚠️  跳过: $skill_name (无可用文件)"
        # 仍然创建基本配置
        cat > "$skill_dir/skill.config.json" << EOF
{
  "name": "$skill_name",
  "description": "$skill_desc",
  "category": "$skill_category",
  "author": "$skill_author",
  "enabled": false,
  "auto_activate": false,
  "installed_at": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")",
  "source": "$skill_source"
}
EOF
        return 1
    fi
}

# 安装所有skill
install_all_skills() {
    log_header "开始安装Skill..."

    local installed_count=0
    local total_count=0

    while IFS='|' read -r skill_line; do
        if [ -z "$skill_line" ]; then
            continue
        fi

        ((total_count++))

        skill_name=$(echo "$skill_line" | cut -d'|' -f1)
        skill_dir="$SKILLS_DIR/$skill_name"

        if install_skill "$skill_line" "$skill_dir"; then
            ((installed_count++))
        fi

    done < /tmp/skills_list.txt

    log_success "安装完成! 成功安装: $installed_count/$total_count 个skill"

    return 0
}

# 生成配置文件
generate_config() {
    log_header "生成配置文件..."

    config_file="$CLAUDE_DIR/skills.json"

    # 创建JSON配置
    cat > "$config_file" << 'EOF'
{
  "version": "1.0",
  "skills_directory": "HOME/.claude/skills",
  "enabled_skills": [],
  "settings": {
    "auto_activate": false,
    "debug_mode": false
  },
  "installed_skills": [
EOF

    # 添加已安装的skill
    first=true
    while IFS='|' read -r skill_line; do
        if [ -z "$skill_line" ]; then
            continue
        fi

        skill_name=$(echo "$skill_line" | cut -d'|' -f1)
        skill_desc=$(echo "$skill_line" | cut -d'|' -f2)

        if [ "$first" = true ]; then
            first=false
        else
            echo "," >> "$config_file"
        fi

        cat >> "$config_file" << EOF
    {
      "name": "$skill_name",
      "description": "$skill_desc",
      "installed": true,
      "enabled": false
    }
EOF

    done < /tmp/skills_list.txt

    cat >> "$config_file" << 'EOF'

  ]
}
EOF

    log_success "配置文件已生成: $config_file"
}

