# 主函数
main() {
    echo ""
    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║              Claude官方Skill自动安装器 v2.0                ║"
    echo "║                                                              ║"
    echo "║    🚀 一键安装Claude Code官方开源的所有Skill和Agent        ║"
    echo "║    📦 支持正确JSON解析和详细配置                           ║"
    echo "╚══════════════════════════════════════════════════════════════╝"
    echo ""

    # 检查依赖
    check_dependencies

    # 创建目录
    create_directories

    # 下载marketplace
    if ! download_marketplace; then
        log_error "无法下载marketplace数据，请检查网络连接"
        exit 1
    fi

    # 解析skill列表
    parse_skills

    # 安装skill
    install_all_skills

    # 生成配置
    generate_config

    # 创建文档
    create_detailed_guide
    create_quick_reference

    echo ""
    echo "🎉 恭喜！Claude官方Skill安装成功！"
    echo ""
    echo "📁 Skill目录: $SKILLS_DIR"
    echo "⚙️  配置文件: $CLAUDE_DIR/skills.json"
    echo "📖 详细指南: $SKILLS_DIR/README.md"
    echo "⚡ 快速参考: $SKILLS_DIR/QUICK_REFERENCE.md"
    echo ""
    echo "✨ 现在您可以在Claude Code中享受这些强大的skill了！"
    echo ""
    echo "💡 提示："
    echo "   - 使用 /skill-name 在Claude中调用skill"
    echo "   - 编辑 skill.config.json 启用/禁用skill"
    echo "   - 查看 README.md 了解更多使用方法"
    echo ""
}

# 运行主函数
main "$@"