#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
测试tavily API密钥配置
"""
import os
from tavily import TavilyClient

def test_tavily_api():
    # 尝试通过环境变量
    api_key = os.getenv('TAVILY_API_KEY')
    if api_key:
        print(f"使用环境变量中的API密钥: {api_key[:10]}...")
        client = TavilyClient(api_key=api_key)
    else:
        print("环境变量中没有找到API密钥")
        return False

    try:
        result = client.search("株洲产业投资", max_results=3)
        print("搜索成功!")
        print(f"结果数量: {len(result.get('results', []))}")
        return True
    except Exception as e:
        print(f"搜索失败: {e}")
        return False

if __name__ == "__main__":
    test_tavily_api()