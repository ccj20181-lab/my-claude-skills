#!/usr/bin/env node

// MCP服务器测试脚本

require('dotenv').config();
const { spawn } = require('child_process');
const path = require('path');

console.log('🧪 测试MCP服务器启动...\n');

// 启动MCP服务器
const mcpProcess = spawn('node', [path.join(__dirname, 'index.js')], {
  stdio: ['pipe', 'pipe', 'pipe']
});

let serverOutput = '';
let serverReady = false;

mcpProcess.stdout.on('data', (data) => {
  const output = data.toString();
  console.log('📤 服务器输出:', output);
  serverOutput += output;

  if (output.includes('Tavily MCP服务器已启动')) {
    serverReady = true;
    console.log('✅ 服务器启动成功!');

    // 发送测试消息
    setTimeout(() => {
      console.log('\n🚀 发送初始化消息...');
      mcpProcess.stdin.write(JSON.stringify({
        jsonrpc: '2.0',
        id: 1,
        method: 'initialize',
        params: {
          protocolVersion: '2024-11-05',
          capabilities: {},
          clientInfo: {
            name: 'test-client',
            version: '1.0.0'
          }
        }
      }) + '\n');
    }, 500);
  }
});

mcpProcess.stderr.on('data', (data) => {
  const error = data.toString();
  console.log('❌ 服务器错误:', error);
});

mcpProcess.on('close', (code) => {
  console.log(`\n🔚 服务器进程结束，退出码: ${code}`);
});

// 超时关闭
setTimeout(() => {
  console.log('\n⏰ 测试超时，关闭服务器');
  mcpProcess.kill();
  process.exit(0);
}, 10000);

process.on('SIGINT', () => {
  mcpProcess.kill();
  process.exit(0);
});