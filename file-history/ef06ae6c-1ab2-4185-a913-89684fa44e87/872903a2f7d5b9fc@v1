
import akshare as ak
import datetime
import pandas as pd

def test_earnings_calendar():
    # Attempt to fetch 2025 Annual Report schedule (since date is 2026-01-18)
    period = "2025年报"
    print(f"Fetching disclosure schedule for {period}...")
    try:
        df = ak.stock_report_disclosure(market="沪深京", period=period)
        if df is None or df.empty:
            print("Result is empty.")
        else:
            print("Success! Columns:", df.columns.tolist())
            print("First few rows:")
            print(df.head())

            # Check date format
            # Usually '首次预约时间' or '变更日期'
            print("\nSample Dates:")
            if '首次预约' in df.columns:
                print(df['首次预约'].head())
            elif '预约披露时间' in df.columns:
                print(df['预约披露时间'].head())

    except Exception as e:
        print(f"Error: {e}")

if __name__ == "__main__":
    test_earnings_calendar()
