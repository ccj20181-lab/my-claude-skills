#!/usr/bin/env python3
"""
Financial Calendar Reminder
Fetches economic events for today and tomorrow, and sends a notification via PushPlus.
"""

import os
import sys
import datetime
import pytz
import akshare as ak
import pandas as pd
import traceback

# Add current directory to sys.path to import send_pushplus
current_dir = os.path.dirname(os.path.abspath(__file__))
sys.path.append(current_dir)

try:
    from send_pushplus import send_pushplus_notification
except ImportError:
    # Fallback if running from root directory
    sys.path.append(os.path.join(os.getcwd(), 'scripts'))
    from send_pushplus import send_pushplus_notification

def get_current_time():
    """Get current time in Shanghai timezone"""
    tz = pytz.timezone('Asia/Shanghai')
    return datetime.datetime.now(tz)

def fetch_economic_calendar(date_obj):
    """
    Fetch economic calendar for a specific date using akshare.
    Returns a DataFrame or None if failed/empty.
    """
    date_str = date_obj.strftime("%Y%m%d")
    print(f"Fetching economic calendar for {date_str}...")

    try:
        # Try Jin10 interface first (most reliable for Chinese users)
        # Note: akshare interface names can be volatile.
        # We try to use the most common one for Jin10 economic calendar.
        df = ak.calendar_economic_jin10(date=date_str)
        return df
    except Exception as e:
        print(f"Error fetching Jin10 calendar: {e}")
        try:
            # Fallback to another source if available or return None
            # For now, we just log the error.
            return None
        except Exception as e2:
            print(f"Fallback failed: {e2}")
            return None

def format_event_row(row):
    """Format a single event row from the dataframe"""
    # Columns usually include: '时间', '地区', '指标内容', '前值', '预测值', '公布值', '重要性'
    time = row.get('时间', 'N/A')
    country = row.get('地区', 'N/A')
    event = row.get('指标内容', row.get('事件', 'N/A'))
    importance = row.get('重要性', '')

    # Add star emoji for importance
    if '高' in str(importance) or '3' in str(importance):
        icon = "🔴" # High importance
    elif '中' in str(importance) or '2' in str(importance):
        icon = "🟡" # Medium
    else:
        icon = "⚪" # Low

    return f"- {time} {icon} **{country}**: {event}"

def process_calendar_data(df):
    """
    Process and filter calendar data.
    Returns a list of formatted strings for important events.
    """
    if df is None or df.empty:
        return []

    formatted_events = []

    # Normalize columns if needed
    # Jin10 usually has: "时间", "地区", "指标内容", "重要性", "前值", "预测值"

    for _, row in df.iterrows():
        importance = str(row.get('重要性', ''))

        # Filter for High importance (高 or 3 stars)
        # Some sources use '高', others might use stars
        if '高' in importance:
            formatted_events.append(format_event_row(row))

    return formatted_events

def main():
    # 1. Setup
    token = os.environ.get("PUSHPLUS_TOKEN")
    if not token:
        print("[Error] PUSHPLUS_TOKEN not found")
        sys.exit(1)

    now = get_current_time()
    today = now.date()
    tomorrow = today + datetime.timedelta(days=1)

    print(f"Running Financial Calendar for {today}")

    # 2. Fetch Data
    today_df = fetch_economic_calendar(today)
    tomorrow_df = fetch_economic_calendar(tomorrow)

    today_events = process_calendar_data(today_df)
    tomorrow_events = process_calendar_data(tomorrow_df)

    # 3. Build Message
    message_parts = []

    # Header
    message_parts.append(f"# 📅 财经日历提醒 ({today})")
    message_parts.append(f"> 生成时间: {now.strftime('%H:%M')}")
    message_parts.append("---")

    # Today's Highlights
    message_parts.append("## 🚨 今日重要数据 (Today)")
    if today_events:
        message_parts.extend(today_events)
    else:
        message_parts.append("今日无重点关注的高重要性数据。")

    message_parts.append("")

    # Tomorrow's Preview
    message_parts.append("## 🔮 明日预告 (Tomorrow)")
    if tomorrow_events:
        message_parts.extend(tomorrow_events)
    else:
        message_parts.append("明日暂无高重要性数据预告。")

    message_parts.append("")
    message_parts.append("---")
    message_parts.append("**注**: 🔴=高重要性 🟡=中重要性")

    full_content = "\n".join(message_parts)
    print("Generated Content:")
    print(full_content)

    # 4. Send Notification
    title = f"📅 财经日历提醒 {today}"
    success = send_pushplus_notification(token, title, full_content)

    if success:
        print("Notification sent successfully.")
    else:
        print("Failed to send notification.")
        sys.exit(1)

if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        traceback.print_exc()
        sys.exit(1)
