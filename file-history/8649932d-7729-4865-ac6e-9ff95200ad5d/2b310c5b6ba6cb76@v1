#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
打开并显示特斯拉财务数据Excel文件
"""

import pandas as pd
import sys

def open_excel_file(file_path):
    """打开并显示Excel文件内容"""
    try:
        # 读取Excel文件的所有工作表
        excel_data = pd.read_excel(file_path, sheet_name=None)

        print("📊 特斯拉财务数据表格内容")
        print("=" * 80)

        for sheet_name, df in excel_data.items():
            print(f"\n📋 工作表: {sheet_name}")
            print("-" * 60)

            # 显示数据
            print(df.to_string(index=False, max_rows=50, max_cols=10))

            # 显示数据维度信息
            print(f"\n数据维度: {df.shape[0]} 行 × {df.shape[1]} 列")
            print("-" * 60)

        # 显示文件信息
        print(f"\n📁 文件信息:")
        print(f"文件路径: {file_path}")
        print(f"工作表数量: {len(excel_data)}")

        return True

    except FileNotFoundError:
        print(f"❌ 错误: 找不到文件 {file_path}")
        return False
    except Exception as e:
        print(f"❌ 错误: 无法读取Excel文件 - {str(e)}")
        return False

if __name__ == "__main__":
    file_path = "/Users/henry/特斯拉财务数据报告.xlsx"
    success = open_excel_file(file_path)

    if success:
        print("\n✅ Excel文件已成功打开！")
    else:
        print("\n❌ 打开Excel文件失败！")
        sys.exit(1)