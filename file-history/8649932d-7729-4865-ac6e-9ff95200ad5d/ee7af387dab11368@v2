    # 创建DataFrame
    df_main = pd.DataFrame(financial_data)
    df_ratios = pd.DataFrame(financial_ratios)
    df_stock = pd.DataFrame(stock_info)

    # 创建Excel文件
    excel_file = '/Users/henry/特斯拉财务数据报告.xlsx'

    with pd.ExcelWriter(excel_file, engine='openpyxl') as writer:
        # 写入不同的工作表
        df_main.to_excel(writer, sheet_name='主要财务数据', index=False)
        df_ratios.to_excel(writer, sheet_name='财务比率', index=False)
        df_stock.to_excel(writer, sheet_name='股票信息', index=False)

        # 创建汇总工作表
        summary_data = {
            '关键指标': ['总收入', '净利润', '总资产', '市值估计', '现金流状况'],
            '数值': ['280.95亿美元', '13.73亿美元', '1,337.35亿美元', '约1.45万亿美元*', '健康'],
            '备注': ['2025年Q3数据', '利润率4.89%', '财务状况良好', '基于市净率推算', '自由现金流38.70亿美元']
        }
        df_summary = pd.DataFrame(summary_data)
        df_summary.to_excel(writer, sheet_name='财务摘要', index=False)

    print(f"✅ Excel文件已创建: {excel_file}")
    return excel_file, df_main, df_ratios

def create_financial_charts(df_main, df_ratios):
    """创建财务分析图表"""
    # 设置图表样式
    plt.style.use('seaborn-v0_8')
    fig = plt.figure(figsize=(20, 15))

    # 1. 主要财务数据柱状图
    plt.subplot(2, 3, 1)
    revenue_data = df_main['数值 (USD)'].head(4)  # 前4个主要指标
    labels = ['收入', '经营支出', '净收入', 'EBITDA']
    colors = ['#1f77b4', '#ff7f0e', '#2ca02c', '#d62728']
    bars = plt.bar(labels, revenue_data, color=colors, alpha=0.8)
    plt.title('特斯拉主要财务数据 (十亿美元)', fontsize=14, fontweight='bold')
    plt.ylabel('金额 (十亿美元)')
    plt.xticks(rotation=45)

    # 添加数值标签
    for bar, value in zip(bars, revenue_data):
        plt.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 5,
                f'{value:.1f}B', ha='center', va='bottom', fontweight='bold')

    # 2. 现金流分析
    plt.subplot(2, 3, 2)
    cash_flow_data = df_main['数值 (USD)'].iloc[8:12]  # 现金流数据
    cash_flow_labels = ['运营现金流', '投资现金流', '融资现金流', '自由现金流']
    colors_cf = ['#2ca02c', '#ff7f0e', '#1f77b4', '#d62728']
    bars_cf = plt.bar(cash_flow_labels, cash_flow_data, color=colors_cf, alpha=0.8)
    plt.title('特斯拉现金流分析 (十亿美元)', fontsize=14, fontweight='bold')
    plt.ylabel('金额 (十亿美元)')
    plt.xticks(rotation=45)

    # 添加数值标签
    for bar, value in zip(bars_cf, cash_flow_data):
        plt.text(bar.get_x() + bar.get_width()/2,
                bar.get_height() + (1 if value >= 0 else -3),
                f'{value:.1f}B', ha='center', va='bottom' if value >= 0 else 'top', fontweight='bold')

    # 3. 资产负债结构
    plt.subplot(2, 3, 3)
    balance_data = df_main['数值 (USD)'].iloc[5:8]  # 资产负债数据
    balance_labels = ['总资产', '负债总额', '权益总额']
    colors_balance = ['#9467bd', '#8c564b', '#17becf']
    plt.pie(balance_data, labels=balance_labels, colors=colors_balance, autopct='%1.1f%%',
            startangle=90, textprops={'fontsize': 10})
    plt.title('特斯拉资产负债结构', fontsize=14, fontweight='bold')

    # 4. 财务比率雷达图
    plt.subplot(2, 3, 4)
    ratios = df_ratios['财务比率'].tolist()
    values = df_ratios['数值'].tolist()

    # 标准化数据用于雷达图
    angles = np.linspace(0, 2 * np.pi, len(ratios), endpoint=False)
    values_plot = values + [values[0]]  # 闭合图形
    angles_plot = np.concatenate((angles, [angles[0]]))

    ax = plt.subplot(2, 3, 4, projection='polar')
    ax.plot(angles_plot, values_plot, 'o-', linewidth=2, color='#1f77b4')
    ax.fill(angles_plot, values_plot, alpha=0.25, color='#1f77b4')
    ax.set_xticks(angles)
    ax.set_xticklabels([r.replace(' ', '\n') for r in ratios], fontsize=8)
    ax.set_title('特斯拉财务比率雷达图', fontsize=14, fontweight='bold', pad=20)

    # 5. 盈利能力分析
    plt.subplot(2, 3, 5)
    profit_metrics = ['净利润率', '资产回报率', '资本回报率']
    profit_values = [4.89, 3.55, 5.01]
    colors_profit = ['#ff9999', '#66b3ff', '#99ff99']
    bars_profit = plt.bar(profit_metrics, profit_values, color=colors_profit, alpha=0.8)
    plt.title('特斯拉盈利能力指标 (%)', fontsize=14, fontweight='bold')
    plt.ylabel('百分比 (%)')

    # 添加数值标签
    for bar, value in zip(bars_profit, profit_values):
        plt.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 0.1,
                f'{value:.1f}%', ha='center', va='bottom', fontweight='bold')

    # 6. 现金储备分析
    plt.subplot(2, 3, 6)
    cash_data = [416.47, 62.38, 38.70]  # 现金储备、运营现金流、自由现金流
    cash_labels = ['现金及短期投资', '运营现金流', '自由现金流']
    colors_cash = ['#ffcc99', '#ff9966', '#ff6666']
    bars_cash = plt.bar(cash_labels, cash_data, color=colors_cash, alpha=0.8)
    plt.title('特斯拉现金状况 (十亿美元)', fontsize=14, fontweight='bold')
    plt.ylabel('金额 (十亿美元)')
    plt.xticks(rotation=45)

    # 添加数值标签
    for bar, value in zip(bars_cash, cash_data):
        plt.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 5,
                f'{value:.1f}B', ha='center', va='bottom', fontweight='bold')

    plt.tight_layout()
    plt.savefig('/Users/henry/特斯拉财务分析图表.png', dpi=300, bbox_inches='tight')
    plt.show()
    print("✅ 财务分析图表已保存: /Users/henry/特斯拉财务分析图表.png")

