#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
创建专业的特斯拉财务数据Excel表格
"""

import pandas as pd
from openpyxl import Workbook
from openpyxl.styles import Font, PatternFill, Alignment, Border, Side
from openpyxl.utils.dataframe import dataframe_to_rows
import sys

def create_professional_excel():
    """创建专业的特斯拉财务数据Excel表格"""
    # 创建工作簿
    wb = Workbook()

    # 删除默认工作表
    wb.remove(wb.active)

    # 定义样式
    header_font = Font(name='Arial', size=12, bold=True, color='FFFFFF')
    header_fill = PatternFill(start_color='366092', end_color='366092', fill_type='solid')

    data_font = Font(name='Arial', size=10)
    number_font = Font(name='Arial', size=10, bold=True)

    # 边框样式
    thin_border = Border(
        left=Side(style='thin'),
        right=Side(style='thin'),
        top=Side(style='thin'),
        bottom=Side(style='thin')
    )

    # 对齐样式
    center_alignment = Alignment(horizontal='center', vertical='center')
    left_alignment = Alignment(horizontal='left', vertical='center')

    # 1. 主要财务数据工作表
    ws1 = wb.create_sheet('主要财务数据')

    # 财务数据
    financial_data = [
        ['财务指标', '数值 (USD)', '单位'],
        ['收入 (Revenue)', 280.95, '十亿美元'],
        ['经营支出 (Operating Expenses)', 31.92, '十亿美元'],
        ['净收入 (Net Income)', 13.73, '十亿美元'],
        ['息税折旧摊销前利润 (EBITDA)', 34.87, '十亿美元'],
        ['现金及短期投资 (Cash & Short-term)', 416.47, '十亿美元'],
        ['总资产 (Total Assets)', 1337.35, '十亿美元'],
        ['负债总额 (Total Liabilities)', 530.19, '十亿美元'],
        ['权益总额 (Total Equity)', 807.16, '十亿美元'],
        ['运营现金流 (Operating Cash Flow)', 62.38, '十亿美元'],
        ['投资现金流 (Investing Cash Flow)', -43.55, '十亿美元'],
        ['融资现金流 (Financing Cash Flow)', 9.83, '十亿美元'],
        ['自由现金流 (Free Cash Flow)', 38.70, '十亿美元']
    ]

    # 填充数据到工作表
    for row_num, row_data in enumerate(financial_data, 1):
        for col_num, value in enumerate(row_data, 1):
            cell = ws1.cell(row=row_num, column=col_num, value=value)

            if row_num == 1:  # 表头
                cell.font = header_font
                cell.fill = header_fill
                cell.alignment = center_alignment
            else:
                cell.font = data_font
                cell.alignment = left_alignment if col_num == 1 else center_alignment

                if col_num == 2:  # 数值列
                    cell.font = number_font
                    if isinstance(value, (int, float)):
                        cell.number_format = '#,##0.00'

            cell.border = thin_border

    # 设置列宽
    ws1.column_dimensions['A'].width = 35
    ws1.column_dimensions['B'].width = 15
    ws1.column_dimensions['C'].width = 15

    # 2. 财务比率工作表
    ws2 = wb.create_sheet('财务比率')

    ratios_data = [
        ['财务比率', '数值', '单位'],
        ['净利润率 (Net Profit Margin)', 4.89, '%'],
        ['每股收益 (EPS)', 0.50, '美元'],
        ['市净率 (P/B Ratio)', 17.93, '倍数'],
        ['资产回报率 (ROA)', 3.55, '%'],
        ['资本回报率 (ROE)', 5.01, '%'],
        ['有效税率 (Effective Tax Rate)', 29.10, '%']
    ]

    for row_num, row_data in enumerate(ratios_data, 1):
        for col_num, value in enumerate(row_data, 1):
            cell = ws2.cell(row=row_num, column=col_num, value=value)

            if row_num == 1:  # 表头
                cell.font = header_font
                cell.fill = header_fill
                cell.alignment = center_alignment
            else:
                cell.font = data_font
                cell.alignment = left_alignment if col_num == 1 else center_alignment

                if col_num == 2:  # 数值列
                    cell.font = number_font
                    if isinstance(value, (int, float)):
                        if value < 10:  # 小数值用更多小数位
                            cell.number_format = '0.00'
                        else:
                            cell.number_format = '0.00'

            cell.border = thin_border

    ws2.column_dimensions['A'].width = 35
    ws2.column_dimensions['B'].width = 15
    ws2.column_dimensions['C'].width = 15

    # 3. 股票信息工作表
    ws3 = wb.create_sheet('股票信息')

    stock_data = [
        ['股票指标', '数值'],
        ['股票代码', 'TSLA'],
        ['交易所', 'NASDAQ'],
        ['发行在外股份', '33.26亿股'],
        ['行业分类', '汽车制造/电动汽车'],
        ['公司规模', '大盘股']
    ]

    for row_num, row_data in enumerate(stock_data, 1):
        for col_num, value in enumerate(row_data, 1):
            cell = ws3.cell(row=row_num, column=col_num, value=value)

            if row_num == 1:  # 表头
                cell.font = header_font
                cell.fill = header_fill
                cell.alignment = center_alignment
            else:
                cell.font = data_font
                cell.alignment = left_alignment

            cell.border = thin_border

    ws3.column_dimensions['A'].width = 20
    ws3.column_dimensions['B'].width = 25

    # 4. 财务摘要工作表
    ws4 = wb.create_sheet('财务摘要')

    summary_data = [
        ['关键指标', '数值', '备注'],
        ['总收入', '280.95亿美元', '2025年Q3数据'],
        ['净利润', '13.73亿美元', '利润率4.89%'],
        ['总资产', '1,337.35亿美元', '财务状况良好'],
        ['市值估计', '约1.45万亿美元*', '基于市净率推算'],
        ['现金流状况', '健康', '自由现金流38.70亿美元']
    ]

    for row_num, row_data in enumerate(summary_data, 1):
        for col_num, value in enumerate(row_data, 1):
            cell = ws4.cell(row=row_num, column=col_num, value=value)

            if row_num == 1:  # 表头
                cell.font = header_font
                cell.fill = header_fill
                cell.alignment = center_alignment
            else:
                cell.font = data_font
                cell.alignment = left_alignment

            cell.border = thin_border

    ws4.column_dimensions['A'].width = 15
    ws4.column_dimensions['B'].width = 20
    ws4.column_dimensions['C'].width = 25

    # 添加数据来源说明
    for ws in [ws1, ws2, ws3, ws4]:
        # 在最后一行添加数据来源
        last_row = ws.max_row + 2
        ws.cell(row=last_row, column=1, value="数据来源: Yahoo Finance (2025年Q3)")
        ws.cell(row=last_row, column=1).font = Font(name='Arial', size=9, italic=True, color='666666')

        last_row += 1
        ws.cell(row=last_row, column=1, value="报告生成时间: 2026-01-09")
        ws.cell(row=last_row, column=1).font = Font(name='Arial', size=9, italic=True, color='666666')

    # 保存文件
    output_file = "/Users/henry/特斯拉财务数据报告_专业版.xlsx"
    wb.save(output_file)

    print(f"✅ 专业版Excel文件已创建: {output_file}")
    return output_file

if __name__ == "__main__":
    create_professional_excel()