#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
详细打开特斯拉财务数据Excel表格
"""

import pandas as pd
import sys
import os

def open_excel_detailed():
    """详细打开Excel文件并展示内容"""
    excel_file = "/Users/henry/特斯拉财务数据报告_专业版.xlsx"

    if not os.path.exists(excel_file):
        print(f"❌ 文件不存在: {excel_file}")
        return False

    try:
        # 读取Excel文件
        xl = pd.ExcelFile(excel_file)

        print("📊 特斯拉财务数据Excel表格详细展示")
        print("=" * 100)
        print(f"📁 文件: {os.path.basename(excel_file)}")
        print(f"📋 工作表: {len(xl.sheet_names)} 个")
        print("=" * 100)

        # 逐个工作表展示
        for i, sheet_name in enumerate(xl.sheet_names, 1):
            print(f"\n📋 【工作表 {i}: {sheet_name}】")
            print("=" * 80)

            df = pd.read_excel(excel_file, sheet_name=sheet_name)

            # 清理数据，去除空行
            df = df.dropna(how='all')

            print("表格内容:")
            print("-" * 80)

            # 格式化显示
            for idx, row in df.iterrows():
                print(f"第 {idx+1:2d} 行: ", end="")
                row_data = []
                for col in df.columns:
                    value = row[col]
                    if pd.isna(value):
                        value = "-"
                    # 格式化数值
                    if isinstance(value, (int, float)) and value != 0:
                        if abs(value) >= 1000000000:
                            value_str = f"{value/1000000000:.2f}B"
                        elif abs(value) >= 1000000:
                            value_str = f"{value/1000000:.2f}M"
                        else:
                            value_str = f"{value:.2f}"
                    else:
                        value_str = str(value)

                    row_data.append(f"{col}: {value_str}")

                print(" | ".join(row_data))

            print("-" * 80)
            print(f"📊 数据维度: {df.shape[0]} 行 × {df.shape[1]} 列")

        # 财务亮点总结
        print("\n" + "=" * 100)
        print("🔍 特斯拉财务数据亮点总结")
        print("=" * 100)

        # 读取主要财务数据
        main_df = pd.read_excel(excel_file, sheet_name='主要财务数据')
        main_df = main_df.dropna(how='all')

        key_metrics = {
            '总收入': 280.95,
            '净利润': 13.73,
            '运营现金流': 62.38,
            '自由现金流': 38.70,
            '现金储备': 416.47,
            '总资产': 1337.35
        }

        print("💰 关键财务指标 (单位: 十亿美元):")
        print("-" * 50)
        for metric, value in key_metrics.items():
            print(f"• {metric:10s}: {value:8.2f}")

        # 读取财务比率
        ratios_df = pd.read_excel(excel_file, sheet_name='财务比率')
        ratios_df = ratios_df.dropna(how='all')

        print("\n📊 关键财务比率:")
        print("-" * 50)
        for idx, row in ratios_df.iterrows():
            ratio = row['财务比率']
            value = row['数值']
            unit = row['单位']
            print(f"• {ratio:25s}: {value:6.2f} {unit}")

        print("\n✅ Excel表格内容展示完成！")
        return True

    except Exception as e:
        print(f"❌ 错误: {str(e)}")
        return False

if __name__ == "__main__":
    success = open_excel_detailed()
    if not success:
        sys.exit(1)