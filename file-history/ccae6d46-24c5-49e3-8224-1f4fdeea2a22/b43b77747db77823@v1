#!/usr/bin/env python3
"""
提取候选笔记并生成Excel报告
"""
import json
import math
from datetime import datetime
import os

# 输出目录
OUTPUT_DIR = os.path.expanduser("~/Documents")
os.makedirs(OUTPUT_DIR, exist_ok=True)

# 读取粉丝数据
try:
    with open("/tmp/xhs_followers.json", "r") as f:
        followers_map = json.load(f)
    print(f"✅ 已读取 {len(followers_map)} 个用户的粉丝数据")
except FileNotFoundError:
    print("[ERROR] /tmp/xhs_followers.json 不存在,请先运行 fetch_followers.py")
    followers_map = {}

# 读取候选笔记
try:
    with open("/tmp/xhs_candidates.json", "r") as f:
        candidates = json.load(f)
    print(f"✅ 已读取 {len(candidates)} 条候选笔记")
except FileNotFoundError:
    print("[ERROR] /tmp/xhs_candidates.json 不存在")
    candidates = []

if not candidates or not followers_map:
    print("[ERROR] 数据不完整,无法生成报告")
    exit(1)

# 筛选低粉爆文
# 条件: 粉丝数 < 20000 且 点赞数 > 1000
viral_notes = []
for note in candidates:
    followers = followers_map.get(note["user_id"], 999999)
    if followers < 20000 and note["likes"] > 1000:
        note["followers"] = followers

        # 计算互动率
        interaction_rate = (note["likes"] + note["collects"] + note["comments"]) / max(followers, 1) * 100

        # 计算爆款指数
        viral_score = interaction_rate * math.log10(note["likes"])

        note["interaction_rate"] = round(interaction_rate, 2)
        note["viral_score"] = round(viral_score, 2)
        viral_notes.append(note)

# 按爆款指数排序
viral_notes.sort(key=lambda x: x["viral_score"], reverse=True)

print(f"\n✅ 找到 {len(viral_notes)} 条低粉爆文！")

# 生成Excel文件
try:
    from openpyxl import Workbook
    from openpyxl.styles import Font, PatternFill, Alignment
    from openpyxl.utils import get_column_letter

    wb = Workbook()
    ws = wb.active
    ws.title = "低粉爆文分析"

    # 表头
    headers = ["序号", "笔记标题", "点赞数", "收藏数", "评论数", "博主粉丝数", "互动率(%)", "爆款指数", "笔记链接"]
    ws.append(headers)

    # 表头样式
    header_fill = PatternFill(start_color="4472C4", end_color="4472C4", fill_type="solid")
    header_font = Font(bold=True, color="FFFFFF")

    for col_num, header in enumerate(headers, 1):
        cell = ws.cell(row=1, column=col_num)
        cell.fill = header_fill
        cell.font = header_font
        cell.alignment = Alignment(horizontal="center", vertical="center")

    # 数据行
    for idx, note in enumerate(viral_notes, 1):
        row = [
            idx,
            note["title"][:50],  # 标题截断到50字符
            note["likes"],
            note["collects"],
            note["comments"],
            note["followers"],
            note["interaction_rate"],
            note["viral_score"],
            f"https://www.xiaohongshu.com/explore/{note['id']}"
        ]
        ws.append(row)

        # 数据行样式
        for col_num in range(1, len(row) + 1):
            cell = ws.cell(row=idx + 1, column=col_num)
            cell.alignment = Alignment(vertical="center", wrap_text=True)
            if col_num == 1:  # 序号列居中
                cell.alignment = Alignment(horizontal="center", vertical="center")

    # 调整列宽
    column_widths = [6, 50, 10, 10, 10, 12, 12, 12, 50]
    for col_num, width in enumerate(column_widths, 1):
        ws.column_dimensions[get_column_letter(col_num)].width = width

    # 保存文件
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    filename = f"小红书爆文分析_{timestamp}.xlsx"
    filepath = os.path.join(OUTPUT_DIR, filename)
    wb.save(filepath)

    print(f"\n✅ Excel 报告已生成: {filepath}")

    # 输出 TOP 5 预览
    print("\n" + "="*80)
    print("📊 TOP 5 低粉爆文预览")
    print("="*80)
    print(f"{'序号':<5}{'标题':<40}{'点赞':<8}{'粉丝':<10}{'爆款指数'}")
    print("-"*80)

    for i, note in enumerate(viral_notes[:5], 1):
        title = note["title"][:38] + "..." if len(note["title"]) > 38 else note["title"]
        print(f"{i:<5}{title:<40}{note['likes']:<8}{note['followers']:<10}{note['viral_score']}")

    print("="*80)
    print(f"\n📈 总计发现 {len(viral_notes)} 条低粉爆文")
    print(f"💾 完整数据已保存至: {filepath}")

except ImportError:
    print("[ERROR] 需要安装 openpyxl: pip3 install openpyxl")
